{
  // Scope: the maintained documentation tree only. The root planning-brief
  // file is a frozen discovery artifact (verbatim source for docs/plan/*,
  // per TASK 0.0.1) and is deliberately not linted here.
  "globs": ["docs/**/*.md"],
  "config": {
    "default": true,
    // Spec prose and reference tables routinely exceed 80 chars by design.
    "MD013": false,
    // Runbooks intentionally continue a task's step numbering across
    // sessions/PRs rather than restarting at 1.
    "MD029": false,
    // Parenthetical asides directly under a heading are a deliberate style
    // in this repo, not an attempt at a heading.
    "MD036": false,
    "MD024": { "siblings_only": true },
  },
}
