---
// TASK 1.2.1: footer built from packages/ui primitives only. Social links
// come from config/social-links.ts (a checked-in, Zod-validated array) —
// "configurable" means editing that file, not this markup.
//
// 2026-09-07: the landmark now closes the page rather than trailing off it.
// It sits on the olive band (`--ndn-color-surface-muted`) instead of the
// paper ground, with the mark and wordmark repeated at the top of it, and its
// two link rows separated by a rule. Nothing about *what* it contains
// changed: `tests/pr-env/nav-footer.test.ts` walks every social and legal
// link out of the same two configs, and both still render from them.
import { t } from '@ndn/i18n';
import type { Locale } from '@ndn/i18n';
import { Heading, Link, visuallyHiddenClassName } from '@ndn/ui';

import { StaffSignInLink } from '../auth/StaffSignInLink.js';
import { legalPages } from '../config/legal-pages.js';
import { socialLinks } from '../config/social-links.js';
import { siteName } from '../site-config.js';

interface Props {
  readonly locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();

// TASK 1.2.1: see Nav.astro's comment on why this is `set:html`, not a
// literal `<style>...</style>` block.
const footerStylesCss = `
/* body > footer, not a bare footer selector. This block is global — Astro's
   scoped styles only reach markup written in this file, and Nav/Footer are
   separate components — so a bare selector styled *every* <footer> on the
   page. That is not hypothetical: a testimonial's attribution line is a
   <footer> inside its <blockquote>, and it was picking up this landmark's
   top border and page padding. Found 2026-09-06 on the redesigned landing
   page, where three quotes sit in cards; it was equally wrong on
   /testimonials, just less visible. BaseLayout.astro's own page-shell CSS
   already restricts itself to body > selectors for exactly this reason. */
body > footer {
  border-block-start: 1px solid var(--ndn-color-border);
  background-color: var(--ndn-color-surface-muted);
  padding-block: 2.5rem 2rem;
  /* Full-bleed band, centred contents — the same 68rem measure the header
     and the landing page's sections use, without needing a wrapper element
     inside the landmark. */
  padding-inline: max(1.25rem, calc((100% - 68rem) / 2));
}

/* The mark again, quietly, at the foot of the page. alt="" for the same
   reason it is empty in the header: the wordmark next to it is real text. */
.ndn-footer-brand {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-block-end: 1.5rem;
}

.ndn-footer-mark {
  display: block;
  width: auto;
  height: 2.25rem;
}

.ndn-footer-wordmark {
  font-family: var(--ndn-font-family-display);
  font-weight: var(--ndn-font-weight-display);
  font-size: 1.375rem;
  line-height: 1.1;
}

.ndn-footer-staff {
  margin-block: 0 1rem;
}

.ndn-footer-social-list,
.ndn-footer-legal-list {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem 1.5rem;
  list-style: none;
  margin-block: 0 1rem;
  margin-inline: 0;
  padding: 0;
}

.ndn-footer-legal-list {
  padding-block-start: 1.25rem;
  border-block-start: 1px solid var(--ndn-color-border-strong);
}

.ndn-footer-legal-list .ndn-link,
.ndn-footer-social-list .ndn-link,
.ndn-footer-staff .ndn-link {
  font-size: 0.875rem;
  color: var(--ndn-color-text-muted);
  text-decoration-color: var(--ndn-color-border-strong);
}

.ndn-footer-legal-list .ndn-link:hover,
.ndn-footer-social-list .ndn-link:hover,
.ndn-footer-staff .ndn-link:hover {
  color: var(--ndn-color-brand-strong);
}

.ndn-footer-copyright {
  margin: 0;
  color: var(--ndn-color-text-muted);
  font-size: 0.8125rem;
}
`;
---

<footer>
  <div class="ndn-footer-brand">
    <img class="ndn-footer-mark" src="/logo-mark.png" alt="" width="30" height="36" />
    <span class="ndn-footer-wordmark">{siteName}</span>
  </div>

  <Heading level={2} className={visuallyHiddenClassName}>
    {t('footer.socialHeading', undefined, locale)}
  </Heading>
  <ul class="ndn-footer-social-list">
    {
      socialLinks.map((link) => (
        <li>
          <Link href={link.href} external>
            {link.label}
          </Link>
        </li>
      ))
    }
  </ul>

  <Heading level={2} className={visuallyHiddenClassName}>
    {t('legal.footerHeading', undefined, locale)}
  </Heading>
  <ul class="ndn-footer-legal-list">
    {
      legalPages.map((page) => (
        <li>
          <Link href={`/${locale}/legal/${page.slug}`}>{t(page.footerLabelKey, undefined, locale)}</Link>
        </li>
      ))
    }
  </ul>

  {/* 2026-09-06: the clinician pool's own sign-in, moved out of the header
      when that was reduced to a single patient control. It has to live
      somewhere — two Cognito pools mean two hosted login pages, and staff
      can only reach theirs through `?pool=clinician`. See
      `auth/StaffSignInLink.tsx` for why it is an island and not an `<a>`. */}
  <Heading level={2} className={visuallyHiddenClassName}>
    {t('footer.staffHeading', undefined, locale)}
  </Heading>
  <p class="ndn-footer-staff">
    <StaffSignInLink client:only="react" label={t('footer.clinicianSignIn', undefined, locale)} />
  </p>

  <p class="ndn-footer-copyright">{t('footer.copyright', { year, siteName }, locale)}</p>
</footer>

<style set:html={footerStylesCss} />
