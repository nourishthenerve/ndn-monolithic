---
// TASK 1.2.1: primary site navigation, built from packages/ui primitives
// only.
//
// **2026-09-02: the sign-in entries are not unconditional.** They were
// rendered on every page whether or not anyone was signed in, and the owner
// — signed in as the principal clinician — clicked "Patient sign in" and
// landed on a test patient's details, because Cognito's own hosted-UI cookie
// for that pool was still live and re-authenticated silently.
// `auth/SessionNav.tsx` carries the full account; what changed here is that
// the entries come from an island that knows whether there is a session, and
// offers sign-out instead when there is.
//
// **2026-09-06: this header holds a brand link and one control.** The site
// is a single page now (`pages/[locale]/index.astro`), so the list of
// sections that used to live up here — About, Services, Blog, Workshops,
// Testimonials, Contact — has nowhere left to point that the page itself
// doesn't already show. The owner: *"at the top there will be only patient
// sign in button."*
//
// So `routes.ts` is no longer read here. It never was a nav list by
// intention — its own header calls it the a11y-scan registration list — and
// the `navLabelKey` field that made it double as one is gone with this
// change. The archives it still registers are reached from the landing
// page's own "read all articles" / "see all workshops" links, and the legal
// pages from the footer.
import { t } from '@ndn/i18n';
import type { Locale } from '@ndn/i18n';

import { SessionNav } from '../auth/SessionNav.js';
import { siteName } from '../site-config.js';

interface Props {
  readonly locale: Locale;
}

const { locale } = Astro.props;

// TASK 1.2.1: a plain `set:html` string, not a literal `<style>...</style>`
// block — same reason index.astro's rootCss/primitiveStylesCss already use
// this shape (see BaseLayout.astro): astro-eslint-parser hands the i18n
// lint rule (packages/eslint-plugin-i18n) raw `<style>` text content as
// `AstroRawText`, which it can't distinguish from real page copy.
const navStylesCss = `
.ndn-nav-header {
  border-block-end: 1px solid rgba(0, 0, 0, 0.08);
  background-color: #ffffff;
}

.ndn-nav-header nav {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  max-width: 68rem;
  margin-inline: auto;
  padding-block: 1rem;
  padding-inline: 1.25rem;
}

.ndn-nav-brand {
  font-weight: 700;
  font-size: 1.125rem;
  text-decoration: none;
  color: var(--ndn-color-text);
}

.ndn-nav-list {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 1rem;
  list-style: none;
  margin: 0;
  padding: 0;
}
`;
---

<header class="ndn-nav-header">
  <nav aria-label={t('nav.primaryLabel', undefined, locale)}>
    <a class="ndn-nav-brand" href={`/${locale}`}>{siteName}</a>
    {/* The island renders its own `<ul>` rather than `<li>`s into one
        written here, and that is a correctness fix rather than a layout
        choice: Astro wraps a `client:only` island in an `<astro-island>`
        element, and a `<ul>` may only directly contain `<li>`, `<script>`
        or `<template>`. Nested inside a list written here this tripped
        axe's `list` rule — serious, WCAG 1.3.1 — on every public page at
        once. See `components/list-structure.test.ts`. */}
    <SessionNav
      client:only="react"
      accountHref={`/${locale}/account`}
      listClassName="ndn-nav-list"
      strings={{
        signIn: t('nav.signIn', undefined, locale),
        account: t('nav.account', undefined, locale),
        signOut: t('account.signOut', undefined, locale),
      }}
    />
  </nav>
</header>

<style set:html={navStylesCss} />
