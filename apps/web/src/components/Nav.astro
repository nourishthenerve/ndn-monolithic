---
// TASK 1.2.1: primary site navigation, built from packages/ui primitives
// only. Reads routes.ts rather than a hard-coded list — a route only
// shows up here if it opts in via `navLabelKey`, so a future non-nav
// route (a blog post, a workshop detail page) can still register for
// 1.1.3's a11y gate without also cluttering primary nav.
//
// Found live, 2026-08-30: TASK 2.2.4 built the sign-in flow itself
// (`GET /auth/signin`, `?pool=clinician` for the other pool) but never
// linked to it from anywhere a visitor would actually find it — the
// homepage carried no way to reach either sign-in path at all.
// `routes.ts`'s own registry deliberately excludes every authenticated
// account-shell page (`account-routes.ts`'s header explains why: it's
// the a11y-scan registration list, not the nav list), and that exclusion
// was mistaken for "no nav entry needed." The sign-in links are added
// directly here rather than through `routes.ts` — plain links, the same
// shape `auth/SignInPanel.tsx`'s own `SignInLink` already uses (a real
// GET, not a click handler; the PKCE cookie needs the request).
//
// **2026-09-02: those links are no longer unconditional.** They were
// rendered on every page whether or not anyone was signed in, and the
// owner — signed in as the principal clinician — clicked "Patient sign
// in" and landed on a test patient's details, because Cognito's own
// hosted-UI cookie for that pool was still live and re-authenticated
// silently. `auth/SessionNav.tsx` carries the full account; what changes
// here is that the entries come from an island that knows whether there
// is a session, and offers sign-out instead when there is.
import { t } from '@ndn/i18n';
import type { Locale } from '@ndn/i18n';
import { Link } from '@ndn/ui';

import { SessionNav } from '../auth/SessionNav.js';
import { routes } from '../routes.js';
import { siteName } from '../site-config.js';

interface Props {
  readonly locale: Locale;
}

const { locale } = Astro.props;

const navRoutes = routes.filter(
  (route): route is (typeof routes)[number] & { navLabelKey: string } =>
    route.locale === locale && route.navLabelKey !== undefined,
);

// TASK 1.2.1: a plain `set:html` string, not a literal `<style>...</style>`
// block — same reason index.astro's rootCss/primitiveStylesCss already use
// this shape (see BaseLayout.astro): astro-eslint-parser hands the i18n
// lint rule (packages/eslint-plugin-i18n) raw `<style>` text content as
// `AstroRawText`, which it can't distinguish from real page copy.
const navStylesCss = `
.ndn-nav-header {
  border-block-end: 1px solid rgba(0, 0, 0, 0.08);
}

.ndn-nav-header nav {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding-block: 1rem;
  padding-inline: 1rem;
}

.ndn-nav-brand {
  font-weight: 700;
  text-decoration: none;
  color: var(--ndn-color-text);
}

.ndn-nav-list {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 1rem;
  list-style: none;
  margin: 0;
  padding: 0;
}
`;
---

<header class="ndn-nav-header">
  <nav aria-label={t('nav.primaryLabel', undefined, locale)}>
    <a class="ndn-nav-brand" href={`/${locale}`}>{siteName}</a>
    <ul class="ndn-nav-list">
      {
        navRoutes.map((route) => (
          <li>
            <Link href={route.path}>{t(route.navLabelKey, undefined, locale)}</Link>
          </li>
        ))
      }
    </ul>
    {/* Its own list, outside the one above, and that is a correctness fix
        rather than a layout choice: Astro wraps a `client:only` island in
        an `<astro-island>` element, and a `<ul>` may only directly contain
        `<li>`, `<script>` or `<template>`. Nested inside the site-nav list
        this tripped axe's `list` rule — serious, WCAG 1.3.1 — on every
        public page at once. The island now renders its own `<ul>` and sits
        beside the first, which is also the more honest structure: site
        navigation and account controls are two groups, not one. */}
    <SessionNav
      client:only="react"
      accountHref={`/${locale}/account`}
      listClassName="ndn-nav-list"
      strings={{
        patientSignIn: t('nav.patientSignIn', undefined, locale),
        clinicianSignIn: t('nav.clinicianSignIn', undefined, locale),
        account: t('nav.account', undefined, locale),
        signOut: t('account.signOut', undefined, locale),
      }}
    />
  </nav>
</header>

<style set:html={navStylesCss} />
