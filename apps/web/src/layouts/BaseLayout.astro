---
// TASK 1.2.1: shared page shell for every `[locale]/*.astro` page —
// replaces the `<html>`/`<head>`/skip-link boilerplate TASK 1.1.2's
// index.astro first hand-wrote.
//
// `<main>` is placed immediately after the skip link in document order,
// with Nav/Footer *after* it, not before: tests/pr-env/keyboard.test.ts
// captures the page's full focus order once, activates the skip link,
// then keeps pressing Tab and expects that *same* captured order to keep
// matching. Once focus programmatically lands on `<main>`, forward-Tab
// can only ever reach elements that come *after* main in the DOM — so if
// Nav sat before main (the conventional arrangement), its links would be
// unreachable by continued tabbing and the suite would fail on this
// page's very first real route. Nav/Footer are pulled back to their
// conventional top/bottom visual positions with flexbox `order` below —
// a deliberate DOM/visual split, not an oversight.
import { localeDirection, t } from '@ndn/i18n';
import type { Locale } from '@ndn/i18n';
import {
  colorSchemeCssVariables,
  CookieBanner,
  primitiveStylesCss,
  reducedMotionGlobalCss,
  SkipLink,
  typeTokenCssVariables,
} from '@ndn/ui';

import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
// TASK 1.2.3: a real imported .css file, not a `set:html` template string
// like the others below — Vite's CSS pipeline resolves fonts.css's
// relative `url()`s against ../assets/fonts, copying each .woff2 into the
// build output as a same-origin, content-hashed asset. That processing
// only runs for an actual `import`, so this one can't be folded into the
// primitiveStylesCss/rootCss pattern.
import '../styles/fonts.css';

interface Props {
  readonly locale: Locale;
  readonly title: string;
  readonly description: string;
  /** TASK 1.3.2: self-referencing canonical for pages that need one (e.g. a blog post). Omitted elsewhere — every other page today has exactly one URL, so a canonical would be a no-op. */
  readonly canonicalHref?: string;
  /** TASK 1.3.2: `apps/web/src/blog/seo.ts`'s output — one `<link rel="alternate">` per populated locale, `x-default` only once 2+ locales exist. */
  readonly hreflangLinks?: readonly { hreflang: string; href: string }[];
}

const { locale, title, description, canonicalHref, hreflangLinks } = Astro.props;
const dir = localeDirection(locale);

const rootVariables = { ...colorSchemeCssVariables('light'), ...typeTokenCssVariables() };
const rootCss = `:root {\n${Object.entries(rootVariables)
  .map(([name, value]) => `  ${name}: ${value};`)
  .join('\n')}\n}`;

// TASK 1.2.1: cross-component layout hook — Nav/Footer are separate Astro
// components, so this can't be a normal *scoped* `<style>` (Astro scoping
// only reaches markup written directly in this file); it's global,
// restricted to `body >` direct-child selectors plus one explicit class so
// it can't leak into an unrelated nested <main>/<footer> a future page
// might render inside its own content. `set:html`, not literal
// `<style>...</style>` text, for the same lint reason as Nav.astro's
// navStylesCss.
const pageShellCss = `
body {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}
body > main {
  order: 2;
  flex: 1 0 auto;
}
body > .ndn-nav-header {
  order: 1;
}
body > footer {
  order: 3;
}
`;
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {canonicalHref && <link rel="canonical" href={canonicalHref} />}
    {hreflangLinks?.map((link) => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}
    <style set:html={rootCss} />
    <style set:html={reducedMotionGlobalCss} />
    <style set:html={primitiveStylesCss} />
    <style set:html={pageShellCss} />
  </head>
  <body>
    <SkipLink>{t('common.skipToContent', undefined, locale)}</SkipLink>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Nav locale={locale} />
    <Footer locale={locale} />
    <CookieBanner
      id="ndn-cookie-consent"
      hidden
      label={t('cookies.banner.label', undefined, locale)}
      message={t('cookies.banner.message', undefined, locale)}
      acceptLabel={t('cookies.banner.accept', undefined, locale)}
      rejectLabel={t('cookies.banner.reject', undefined, locale)}
      policyLabel={t('cookies.banner.policyLink', undefined, locale)}
      policyHref={`/${locale}/legal/cookies`}
    />
    <script>
      // TASK 1.2.3: a plain, externally-bundled module script (Astro
      // hoists and dedupes this across every page into one shared file) —
      // not a client:* island. See CookieBanner.tsx's own comment for
      // why: an island's inline bootstrap script would be silently
      // blocked by the CloudFront CSP's script-src. Starts hidden (the
      // `hidden` attribute above) so a returning visitor who already
      // recorded a choice never sees a flash of the banner if this script
      // is slow to run; only ever reveals it, never assumes a decision
      // either way if `#ndn-cookie-consent` is missing.
      import { hasStoredConsent, setConsent } from '../scripts/consent.js';

      const banner = document.getElementById('ndn-cookie-consent');
      if (banner) {
        if (!hasStoredConsent()) {
          banner.hidden = false;
        }

        banner.querySelector('[data-cookie-action="accept"]')?.addEventListener('click', () => {
          setConsent(['analytics']);
          banner.hidden = true;
        });

        banner.querySelector('[data-cookie-action="reject"]')?.addEventListener('click', () => {
          setConsent([]);
          banner.hidden = true;
        });
      }
    </script>
  </body>
</html>
