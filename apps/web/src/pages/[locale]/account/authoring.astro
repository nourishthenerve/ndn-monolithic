---
// 2026-08-31: writing a blog post or a workshop, with keywords. The owner:
// *"for blogs and webinar there is no way to upload it with tags/keywords
// - it will only be possible via principal clinician account."*
//
// Both APIs have existed since TASK 1.3.2/1.5.1 with nothing pointing at
// them — every post on the live site was written by calling the API by
// hand. Principal-only, in the matrix (`Content item`/`Workshop`, narrowed
// to `Principal` the same day) and here.
//
// Statically generated and **empty**, same discipline every account page
// states. Deliberately absent from routes.ts, same as every sibling.
import { supportedLocales, t } from '@ndn/i18n';
import type { Locale } from '@ndn/i18n';
import { Heading } from '@ndn/ui';

import { AuthoredContentList } from '../../../account/AuthoredContentList.js';
import { AuthoringPanel } from '../../../account/AuthoringPanel.js';
import { RequireAuth } from '../../../auth/RequireAuth.js';
import { SignInLink } from '../../../auth/SignInPanel.js';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { siteName } from '../../../site-config.js';

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const heading = t('authoring.heading', undefined, locale);
---

<BaseLayout
  locale={locale}
  title={`${heading} — ${siteName}`}
  description={t('authoring.description', undefined, locale)}
>
  <Heading level={1}>{heading}</Heading>

  <RequireAuth
    client:only="react"
    loadingLabel={t('account.loading', undefined, locale)}
    allowRoles={['principal-clinician']}
  >
    <Fragment slot="signedOut">
      <p>
        {t('account.signedOut', undefined, locale)}{' '}
        <SignInLink label={t('account.signInClinician', undefined, locale)} pool="clinician" />
      </p>
    </Fragment>
    <Fragment slot="forbidden">
      <p>{t('authoring.forbidden', undefined, locale)}</p>
    </Fragment>
    <AuthoringPanel
      client:only="react"
      strings={{
        blogHeading: t('authoring.blogHeading', undefined, locale),
        blogIntro: t('authoring.blogIntro', undefined, locale),
        workshopHeading: t('authoring.workshopHeading', undefined, locale),
        workshopIntro: t('authoring.workshopIntro', undefined, locale),
        titleLabel: t('authoring.titleLabel', undefined, locale),
        excerptLabel: t('authoring.excerptLabel', undefined, locale),
        bodyLabel: t('authoring.bodyLabel', undefined, locale),
        descriptionLabel: t('authoring.descriptionLabel', undefined, locale),
        keywordsLabel: t('authoring.keywordsLabel', undefined, locale),
        keywordsHint: t('authoring.keywordsHint', undefined, locale),
        dateTimeLabel: t('authoring.dateTimeLabel', undefined, locale),
        capacityLabel: t('authoring.capacityLabel', undefined, locale),
        media: {
          label: t('authoring.mediaLabel', undefined, locale),
          hint: t('authoring.mediaHint', undefined, locale),
          uploading: t('authoring.mediaUploading', undefined, locale),
          uploaded: t('authoring.mediaUploaded', undefined, locale),
          remove: t('authoring.mediaRemove', undefined, locale),
          tooLarge: t('authoring.mediaTooLarge', undefined, locale),
          wrongType: t('authoring.mediaWrongType', undefined, locale),
          failed: t('authoring.mediaFailed', undefined, locale),
          previewAlt: t('authoring.mediaPreviewAlt', undefined, locale),
        },
        publishNowLabel: t('authoring.publishNowLabel', undefined, locale),
        publishNowHint: t('authoring.publishNowHint', undefined, locale),
        submitButton: t('authoring.submitButton', undefined, locale),
        submitting: t('authoring.submitting', undefined, locale),
        successMessage: t('authoring.successMessage', undefined, locale),
        conflictError: t('authoring.conflictError', undefined, locale),
        invalidError: t('authoring.invalidError', undefined, locale),
        slugError: t('authoring.slugError', undefined, locale),
        dateTimeError: t('authoring.dateTimeError', undefined, locale),
        forbidden: t('authoring.forbidden', undefined, locale),
        error: t('authoring.error', undefined, locale),
      }}
    />

    {/* 2026-09-02: what has already been written, and its status. Added
        because a draft was otherwise unreachable — the public read returns
        published items only, and nothing here listed anything else, so a
        post saved before the form began publishing by default was
        invisible with no way to recover it. */}
    <AuthoredContentList
      client:only="react"
      kind="blog"
      locale={locale}
      strings={{
        heading: t('authoredList.blogHeading', undefined, locale),
        loading: t('authoredList.loading', undefined, locale),
        forbidden: t('authoredList.forbidden', undefined, locale),
        error: t('authoredList.error', undefined, locale),
        empty: t('authoredList.empty', undefined, locale),
        titleColumn: t('authoredList.titleColumn', undefined, locale),
        statusColumn: t('authoredList.statusColumn', undefined, locale),
        actionColumn: t('authoredList.actionColumn', undefined, locale),
        publish: t('authoredList.publish', undefined, locale),
        unpublish: t('authoredList.unpublish', undefined, locale),
        working: t('authoredList.working', undefined, locale),
        actionFailed: t('authoredList.actionFailed', undefined, locale),
        viewLabel: t('authoredList.view', undefined, locale),
      }}
    />
    <AuthoredContentList
      client:only="react"
      kind="workshop"
      locale={locale}
      strings={{
        heading: t('authoredList.workshopHeading', undefined, locale),
        loading: t('authoredList.loading', undefined, locale),
        forbidden: t('authoredList.forbidden', undefined, locale),
        error: t('authoredList.error', undefined, locale),
        empty: t('authoredList.empty', undefined, locale),
        titleColumn: t('authoredList.titleColumn', undefined, locale),
        statusColumn: t('authoredList.statusColumn', undefined, locale),
        actionColumn: t('authoredList.actionColumn', undefined, locale),
        publish: t('authoredList.publish', undefined, locale),
        unpublish: t('authoredList.unpublish', undefined, locale),
        working: t('authoredList.working', undefined, locale),
        actionFailed: t('authoredList.actionFailed', undefined, locale),
        viewLabel: t('authoredList.view', undefined, locale),
      }}
    />
  </RequireAuth>
</BaseLayout>
