---
// D-34 (2026-08-31): the self-service "change my own password" page —
// the first credential action a clinician takes on themselves rather
// than having a principal take it for them (D-29/D-30). Statically
// generated and **empty**, same discipline account/patient-admin.astro
// states — what makes this page private is not server rendering but that
// its content is not in the HTML at all. The island below decides
// whether to render the form, and renders nothing until the session
// resolves.
//
// Deliberately absent from routes.ts, same as account/patient-admin.astro
// and account/caseload.astro — TASK 1.1.3's a11y gate (tests/pr-env/
// a11y-full.test.ts) scans every registered route unauthenticated, and an
// authenticated-only page has no accessible content to find that way.
// This codebase has no live-session pr-env testing mechanism yet for
// this page either — the same honestly-named gap every account-shell
// page added since TASK 5.3.1 names.
import { supportedLocales, t } from '@ndn/i18n';
import type { Locale } from '@ndn/i18n';
import { Heading } from '@ndn/ui';

import { ChangePasswordPanel } from '../../../account/ChangePasswordPanel.js';
import { OwnDetailsPanel } from '../../../account/OwnDetailsPanel.js';
import { RequireAuth } from '../../../auth/RequireAuth.js';
import { SignInLink, SignOutButton } from '../../../auth/SignInPanel.js';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { siteName } from '../../../site-config.js';

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const heading = t('changePassword.heading', undefined, locale);
---

<BaseLayout
  locale={locale}
  title={`${heading} — ${siteName}`}
  description={t('changePassword.description', undefined, locale)}
>
  <Heading level={1}>{heading}</Heading>

  <RequireAuth client:only="react" loadingLabel={t('account.loading', undefined, locale)}>
    <Fragment slot="signedOut">
      <p>
        {t('account.signedOut', undefined, locale)}{' '}
        <SignInLink label={t('account.signInPatient', undefined, locale)} pool="patient" />
        {' · '}
        <SignInLink label={t('account.signInClinician', undefined, locale)} pool="clinician" />
      </p>
    </Fragment>
    <RequireAuth client:only="react" allowRoles={['principal-clinician', 'sub-clinician', 'helpdesk', 'visitor']}>
      <OwnDetailsPanel
        client:only="react"
        strings={{
          heading: t('ownDetails.heading', undefined, locale),
          intro: t('ownDetails.intro', undefined, locale),
          displayNameLabel: t('ownDetails.displayNameLabel', undefined, locale),
          saveButton: t('ownDetails.saveButton', undefined, locale),
          saving: t('ownDetails.saving', undefined, locale),
          savedMessage: t('ownDetails.savedMessage', undefined, locale),
          loading: t('ownDetails.loading', undefined, locale),
          forbidden: t('ownDetails.forbidden', undefined, locale),
          error: t('ownDetails.error', undefined, locale),
        }}
      />
    </RequireAuth>
    <ChangePasswordPanel
      client:only="react"
      strings={{
        heading: t('changePassword.heading', undefined, locale),
        intro: t('changePassword.intro', undefined, locale),
        currentPasswordLabel: t('changePassword.currentPasswordLabel', undefined, locale),
        newPasswordLabel: t('changePassword.newPasswordLabel', undefined, locale),
        confirmPasswordLabel: t('changePassword.confirmPasswordLabel', undefined, locale),
        submitButton: t('changePassword.submitButton', undefined, locale),
        submitting: t('changePassword.submitting', undefined, locale),
        successMessage: t('changePassword.successMessage', undefined, locale),
        mismatchError: t('changePassword.mismatchError', undefined, locale),
        forbidden: t('changePassword.forbidden', undefined, locale),
        incorrectCurrentPasswordError: t(
          'changePassword.incorrectCurrentPasswordError',
          undefined,
          locale,
        ),
        policyViolationError: t('changePassword.policyViolationError', undefined, locale),
        error: t('changePassword.error', undefined, locale),
      }}
    />
    <SignOutButton client:only="react" label={t('account.signOut', undefined, locale)} />
  </RequireAuth>
</BaseLayout>
