---
// D-30: the principal-facing page for creating a colleague's clinician
// account (`POST /clinicians`). Statically generated and **empty**, same
// discipline account/patient-admin.astro states — what makes this page
// private is not server rendering but that its content is not in the
// HTML at all. The island below decides whether to render the form, and
// renders nothing until the session resolves.
//
// Deliberately absent from routes.ts, same as account/patient-admin.astro
// and account/caseload.astro — TASK 1.1.3's a11y gate (tests/pr-env/
// a11y-full.test.ts) scans every registered route unauthenticated, and an
// authenticated-only page has no accessible content to find that way.
// This codebase has no live-session pr-env testing mechanism yet for
// this page either — the same honestly-named gap every account-shell
// page added since TASK 5.3.1 names.
import { supportedLocales, t } from '@ndn/i18n';
import type { Locale } from '@ndn/i18n';
import { Heading } from '@ndn/ui';

import { ClinicianAdminPanel } from '../../../account/ClinicianAdminPanel.js';
import { RequireAuth } from '../../../auth/RequireAuth.js';
import { SignInLink, SignOutButton } from '../../../auth/SignInPanel.js';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { siteName } from '../../../site-config.js';

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const heading = t('clinicianAdmin.heading', undefined, locale);
---

<BaseLayout
  locale={locale}
  title={`${heading} — ${siteName}`}
  description={t('clinicianAdmin.description', undefined, locale)}
>
  <Heading level={1}>{heading}</Heading>

  <RequireAuth
    client:only="react"
    loadingLabel={t('account.loading', undefined, locale)}
    allowRoles={['principal-clinician']}
  >
    <Fragment slot="signedOut">
      <p>
        {t('account.signedOut', undefined, locale)}{' '}
        <SignInLink label={t('account.signInClinician', undefined, locale)} pool="clinician" />
      </p>
    </Fragment>
    <Fragment slot="forbidden">
      <p>{t('clinicianAdmin.forbidden', undefined, locale)}</p>
    </Fragment>
    <ClinicianAdminPanel
      client:only="react"
      strings={{
        forbidden: t('clinicianAdmin.forbidden', undefined, locale),
        createHeading: t('clinicianAdmin.createHeading', undefined, locale),
        createIntro: t('clinicianAdmin.createIntro', undefined, locale),
        emailLabel: t('clinicianAdmin.emailLabel', undefined, locale),
        displayNameLabel: t('clinicianAdmin.displayNameLabel', undefined, locale),
        roleLabel: t('clinicianAdmin.roleLabel', undefined, locale),
        rolePrincipalLabel: t('clinicianAdmin.rolePrincipalLabel', undefined, locale),
        roleSubLabel: t('clinicianAdmin.roleSubLabel', undefined, locale),
        roleHelpdeskLabel: t('clinicianAdmin.roleHelpdeskLabel', undefined, locale),
        createButton: t('clinicianAdmin.createButton', undefined, locale),
        creating: t('clinicianAdmin.creating', undefined, locale),
        createSuccessHeading: t('clinicianAdmin.createSuccessHeading', undefined, locale),
        createSuccessWarning: t('clinicianAdmin.createSuccessWarning', undefined, locale),
        passwordLabel: t('clinicianAdmin.passwordLabel', undefined, locale),
        totpSecretLabel: t('clinicianAdmin.totpSecretLabel', undefined, locale),
        otpauthUriLabel: t('clinicianAdmin.otpauthUriLabel', undefined, locale),
        clinicianIdLabel: t('clinicianAdmin.clinicianIdLabel', undefined, locale),
        createConflictError: t('clinicianAdmin.createConflictError', undefined, locale),
        createValidationError: t('clinicianAdmin.createValidationError', undefined, locale),
        createError: t('clinicianAdmin.createError', undefined, locale),
        passwordFieldLabel: t('clinicianAdmin.passwordFieldLabel', undefined, locale),
        passwordFieldHint: t('clinicianAdmin.passwordFieldHint', undefined, locale),
        createWeakPasswordError: t('clinicianAdmin.createWeakPasswordError', undefined, locale),
        directoryHeading: t('clinicianAdmin.directoryHeading', undefined, locale),
        directoryIntro: t('clinicianAdmin.directoryIntro', undefined, locale),
        directoryLoading: t('clinicianAdmin.directoryLoading', undefined, locale),
        directoryError: t('clinicianAdmin.directoryError', undefined, locale),
        directoryEmpty: t('clinicianAdmin.directoryEmpty', undefined, locale),
        nameColumnLabel: t('clinicianAdmin.nameColumn', undefined, locale),
        roleColumnLabel: t('clinicianAdmin.roleColumn', undefined, locale),
        statusColumnLabel: t('clinicianAdmin.statusColumn', undefined, locale),
        actionColumnLabel: t('clinicianAdmin.actionColumn', undefined, locale),
        statusActiveLabel: t('clinicianAdmin.statusActive', undefined, locale),
        statusDeactivatedLabel: t('clinicianAdmin.statusDeactivated', undefined, locale),
        deactivateButton: t('clinicianAdmin.deactivateButton', undefined, locale),
        reactivateButton: t('clinicianAdmin.reactivateButton', undefined, locale),
        working: t('clinicianAdmin.working', undefined, locale),
        deactivateConfirm: t('clinicianAdmin.deactivateConfirm', undefined, locale),
        actionError: t('clinicianAdmin.actionError', undefined, locale),
      }}
    />
    <SignOutButton client:only="react" label={t('account.signOut', undefined, locale)} />
  </RequireAuth>
</BaseLayout>
