---
// TASK 2.2.4: the first page behind a session. Statically generated and
// **empty** — ADR-0017's static-output decision is intact, because what
// makes this page private is not server rendering but that its content is
// not in the HTML at all. The island below decides whether to build any,
// and renders nothing until the session resolves.
//
// D-34 (2026-08-31): a real, visible link to change-password.astro — this
// page is the one every signed-in identity actually lands on, unlike
// every other account page's own "URL-only reachability" (account-routes.ts).
// Found live: nothing pointed at the feature once it shipped, so nobody
// could find it. Shown to a signed-in patient too, same as every sibling
// account link — the server-side role check (clinician-admin.ts) is the
// real boundary, not this link's visibility.
//
// Amendment, same day: the three staff tools get the same treatment, for
// the same reason and on the same reasoning. The patient dashboard,
// patient accounts and clinician accounts pages have each been reachable
// by typed URL only since they shipped, which is why the owner's request
// for "two options available" reads as though they do not exist — they
// do, there was simply nothing linking to them.
//
// Second amendment, same day: **shown to the principal clinician only.**
// The first cut listed all three unconditionally, arguing that a link
// which lies about what the server will allow beats a menu that quietly
// disagrees with it. The owner, seeing it as a sub-clinician, disagreed —
// *"for a non-principal clinician I dont even want create patient or
// create clinician account to be visible"* — and they are right: the
// menu is not the place to discover you were never allowed. The nested
// `RequireAuth` below hides them on a *known* "not the principal" and
// shows them whenever that cannot be determined, so the failure mode is
// a link the API refuses (today's behaviour) rather than a principal
// locked out of their own tools. See `auth/token-claims.ts` for why this
// is presentation and not authorisation. Change-password stays outside
// it: every signed-in identity, patient included, needs that one.
import { supportedLocales, t } from '@ndn/i18n';
import type { Locale } from '@ndn/i18n';
import { Heading, Link } from '@ndn/ui';

import { RequireAuth } from '../../../auth/RequireAuth.js';
import { SignInLink, SignOutButton } from '../../../auth/SignInPanel.js';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { siteName } from '../../../site-config.js';

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const heading = t('account.heading', undefined, locale);
---

<BaseLayout
  locale={locale}
  title={`${heading} — ${siteName}`}
  description={t('account.description', undefined, locale)}
>
  <Heading level={1}>{heading}</Heading>

  <RequireAuth client:only="react" loadingLabel={t('account.loading', undefined, locale)}>
    <Fragment slot="signedOut">
      <p>
        {t('account.signedOut', undefined, locale)}{' '}
        <SignInLink label={t('account.signInPatient', undefined, locale)} pool="patient" />
        {' · '}
        <SignInLink label={t('account.signInClinician', undefined, locale)} pool="clinician" />
      </p>
    </Fragment>
    <p>{t('account.signedInIntro', undefined, locale)}</p>
    <p>
      <Link href={`/${locale}/account/change-password`}>
        {t('account.changePasswordLink', undefined, locale)}
      </Link>
    </p>
    <RequireAuth client:only="react" requirePrincipalClinician>
      <nav aria-label={t('account.staffToolsHeading', undefined, locale)}>
        <ul>
          <li>
            <Link href={`/${locale}/account/caseload`}>
              {t('account.dashboardLink', undefined, locale)}
            </Link>
          </li>
          <li>
            <Link href={`/${locale}/account/patient-admin`}>
              {t('account.patientAdminLink', undefined, locale)}
            </Link>
          </li>
          <li>
            <Link href={`/${locale}/account/clinician-admin`}>
              {t('account.clinicianAdminLink', undefined, locale)}
            </Link>
          </li>
        </ul>
      </nav>
    </RequireAuth>
    <SignOutButton client:only="react" label={t('account.signOut', undefined, locale)} />
  </RequireAuth>
</BaseLayout>
