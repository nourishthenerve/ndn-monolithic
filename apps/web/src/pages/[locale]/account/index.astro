---
// TASK 2.2.4: the first page behind a session. Statically generated and
// **empty** — ADR-0017's static-output decision is intact, because what
// makes this page private is not server rendering but that its content is
// not in the HTML at all. The islands below decide whether to build any,
// and render nothing until the session resolves.
//
// ## 2026-09-06: for a patient, this page *is* the account
//
// The owner: *"the moment a patient signs in it lands to his dashboard.
// This dashboard has 'My calender', 'Personal Details', 'Testimonial' and
// 'Account' section. Inside 'My Calender' we already have a nice looking
// calender. Inside 'Personal Details' keep all personal details option,
// inside 'Testimonial' keep testimonial content and inside 'Account' have
// option to change password."*
//
// Until now this page was a **menu**: a list of links to `account/patient`,
// `account/appointments`, `account/testimonial` and
// `account/change-password`, plus a notifications feed. A patient signing in
// landed on a page whose entire content was directions to four other pages.
// Now the four pages' content is here, in four named sections, and the
// pages themselves remain — reachable by URL, still registered in
// `account-routes.ts` for the authenticated a11y gate, and still the place
// a deep link lands. What is gone is the layer of links in between.
//
// Two things went with it, at the owner's word — *"remove Updates section
// and My Calender button on dashboard as they are redundant"*:
//
//   * `PatientNotifications` ("Updates"). Its feed is appointment-approved
//     / appointment-cancelled / calendar-updated notices — every one of them
//     a statement about a slot the calendar directly above now shows.
//   * The "My calendar" link, for the same reason twice over: it pointed at
//     `account/appointments`, a forward-only list of the appointments the
//     calendar already draws.
//
// `account.signedInIntro` went too — "your care plan and appointments will
// appear here" was a promise printed directly above the thing it promised.
//
// ## 2026-09-06, second pass: the staff half gets the same treatment
//
// *"in clinician account, i seeing my calander button (this is redundant
// now). Remove it … have an account section to reset password just like you
// did for patient."*
//
// The "My calendar" link pointed at `account/calendar` — a forward-looking
// 30-day list of the appointments the calendar at the top of this page
// already draws, for the same roles. Gone for the same reason the patient's
// own calendar link went.
//
// The change-password link is replaced by an inlined **Account** section, and
// it carries both of that page's panels rather than only the password form:
// `OwnDetailsPanel` is where a clinician sets their display name, and
// inlining half the page would have left the other half reachable by typed
// URL alone.
//
// What is left in the staff shell is genuinely a list of *other* places —
// the caseload, patient administration, clinician administration, authoring
// — none of which is a panel this page could reasonably absorb.
import { supportedLocales, t } from '@ndn/i18n';
import type { Locale } from '@ndn/i18n';
import { Heading, Link } from '@ndn/ui';

import { AppointmentCalendar } from '../../../account/AppointmentCalendar.js';
import { AssessmentForm } from '../../../account/AssessmentForm.js';
import { appointmentCalendarStylesCss } from '../../../account/calendar-styles.js';
import { ChangePasswordPanel } from '../../../account/ChangePasswordPanel.js';
import { OwnDetailsPanel } from '../../../account/OwnDetailsPanel.js';
import { PatientProfile } from '../../../account/PatientProfile.js';
import { TestimonialPanel } from '../../../account/TestimonialPanel.js';
import { RequireAuth } from '../../../auth/RequireAuth.js';
import { SignInLink } from '../../../auth/SignInPanel.js';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { siteName } from '../../../site-config.js';

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const heading = t('account.heading', undefined, locale);

/**
 * Every panel gathered into a named section renders its own heading one
 * level down, so the outline reads "page > section > panel" rather than a
 * flat run of `<h2>`s. See `account/heading-level.ts`.
 */
const PANEL_HEADING_LEVEL = 3;
---

<BaseLayout
  locale={locale}
  title={`${heading} — ${siteName}`}
  description={t('account.description', undefined, locale)}
>
  <Heading level={1}>{heading}</Heading>

  <RequireAuth client:only="react" loadingLabel={t('account.loading', undefined, locale)}>
    <Fragment slot="signedOut">
      <p>
        {t('account.signedOut', undefined, locale)}{' '}
        <SignInLink label={t('account.signInPatient', undefined, locale)} pool="patient" />
        {' · '}
        <SignInLink label={t('account.signInClinician', undefined, locale)} pool="clinician" />
      </p>
    </Fragment>

    {/* ## 1. My calendar
        2026-09-06: *"At the very top I want to show calender … where the
        patient/clinician/principal clinician can scroll left and right to
        see all past and upcoming appointments. There is no concept of
        calender for help desk and visitor."*

        The three roles named are exactly this gate's `allowRoles`; the
        component refuses the other two as well (`calendarSourcesFor`), so it
        is safe wherever it is mounted — but the gate here means a helpdesk
        session never downloads the island at all. No `forbidden` slot: a
        role with no calendar should see no trace of one, not an explanation
        of its absence. The section heading is the component's own. */}
    <RequireAuth
      client:only="react"
      allowRoles={['patient', 'principal-clinician', 'sub-clinician']}
    >
      <AppointmentCalendar
        client:only="react"
        locale={locale}
        strings={{
          heading: t('accountCalendar.heading', undefined, locale),
          loadingLabel: t('accountCalendar.loading', undefined, locale),
          forbiddenLabel: t('accountCalendar.forbidden', undefined, locale),
          errorLabel: t('accountCalendar.error', undefined, locale),
          previousWeeksLabel: t('accountCalendar.previousWeeks', undefined, locale),
          nextWeeksLabel: t('accountCalendar.nextWeeks', undefined, locale),
          todayLabel: t('accountCalendar.today', undefined, locale),
          gridCaption: t('accountCalendar.gridCaption', undefined, locale),
          todayMarker: t('accountCalendar.todayMarker', undefined, locale),
          noAppointmentsOnDay: t('accountCalendar.noAppointmentsOnDay', undefined, locale),
          emptyWindow: t('accountCalendar.emptyWindow', undefined, locale),
          durationLabel: t('accountCalendar.duration', undefined, locale),
          minutesSuffix: t('patientRecord.minutesSuffix', undefined, locale),
          statusLabel: t('accountCalendar.status', undefined, locale),
          joinCallLabel: t('calendar.joinCall', undefined, locale),
          // The four decisions inherited from the deleted `account/calendar`
          // page, reusing its own catalogue entries rather than new copy.
          approveLabel: t('clinicianCalendar.approve', undefined, locale),
          declineLabel: t('clinicianCalendar.decline', undefined, locale),
          completeLabel: t('clinicianCalendar.complete', undefined, locale),
          noShowLabel: t('clinicianCalendar.noShow', undefined, locale),
          decidingLabel: t('clinicianCalendar.deciding', undefined, locale),
          decideFailedLabel: t('clinicianCalendar.decideFailed', undefined, locale),
          statusLabels: {
            // Keyed by the API's own `appointment_status` values
            // (`packages/shared-types/src/appointment.ts`), so an
            // unrecognised one falls through to the raw value rather than
            // rendering blank.
            scheduled: t('accountCalendar.status.scheduled', undefined, locale),
            'pending-approval': t('accountCalendar.status.pendingApproval', undefined, locale),
            completed: t('accountCalendar.status.completed', undefined, locale),
            cancelled: t('accountCalendar.status.cancelled', undefined, locale),
            'no-show': t('accountCalendar.status.noShow', undefined, locale),
          },
        }}
      />
    </RequireAuth>

    {/* ## 2. Personal details — `account/patient`'s content, less three
        panels the owner has since cut.

        *"remove the next appointment panel too, its redundant"* —
        `NextAppointmentPanel` showed one appointment, the next one, directly
        beneath a calendar that draws all of them and a day panel that
        details them. It was the third rendering of the same data on one
        screen.

        *"remove care plan and diagnosis plan as I dont know when I define
        these sections"* — both `ClinicalRecordTimeline` panels are gone.
        They are not deleted, only unmounted here: `account/patient` still
        renders them, the API and its history are untouched, and putting
        them back is a matter of restoring these props once the clinic knows
        what belongs in them.

        What remains is the profile form and the assessment form. */}
    <RequireAuth client:only="react" allowRoles={['patient']}>
      <section aria-labelledby="personal-details-heading">
        <Heading level={2} id="personal-details-heading">
          {t('account.personalDetailsHeading', undefined, locale)}
        </Heading>
        <PatientProfile
          client:only="react"
          strings={{
            loadingLabel: t('patientProfile.loading', undefined, locale),
            forbiddenLabel: t('patientProfile.forbidden', undefined, locale),
            errorLabel: t('patientProfile.error', undefined, locale),
            savedLabel: t('patientProfile.saved', undefined, locale),
            fullNameLabel: t('patientProfile.fullName', undefined, locale),
            emailLabel: t('patientProfile.email', undefined, locale),
            phoneLabel: t('patientProfile.phone', undefined, locale),
            marketingOptInLabel: t('patientProfile.marketingOptIn', undefined, locale),
            saveLabel: t('patientProfile.save', undefined, locale),
            savingLabel: t('patientProfile.saving', undefined, locale),
          }}
        />
        {/* Resolves to the signed-in patient's own form (`me`), so no `?id=`
            is involved — they see general info (theirs to edit), the patient
            section and the calendar (both read-only), never the
            clinician's. */}
        <AssessmentForm
          client:only="react"
          headingLevel={PANEL_HEADING_LEVEL}
          strings={{
            heading: t('assessment.heading', undefined, locale),
            loadingLabel: t('assessment.loading', undefined, locale),
            forbiddenLabel: t('assessment.forbidden', undefined, locale),
            notFoundLabel: t('assessment.notFound', undefined, locale),
            errorLabel: t('assessment.error', undefined, locale),
            missingIdLabel: t('assessment.missingId', undefined, locale),
            saveLabel: t('assessment.save', undefined, locale),
            savingLabel: t('assessment.saving', undefined, locale),
            savedLabel: t('assessment.saved', undefined, locale),
            conflictLabel: t('assessment.conflict', undefined, locale),
            saveForbiddenLabel: t('assessment.saveForbidden', undefined, locale),
            readOnlyLabel: t('assessment.readOnly', undefined, locale),
            attachmentsHeading: t('assessment.attachmentsHeading', undefined, locale),
            attachmentsEmpty: t('assessment.attachmentsEmpty', undefined, locale),
            addFileLabel: t('assessment.addFile', undefined, locale),
            uploadingLabel: t('assessment.uploading', undefined, locale),
            uploadFailedLabel: t('assessment.uploadFailed', undefined, locale),
            downloadLabel: t('assessment.download', undefined, locale),
            noNextAppointmentLabel: t('assessment.noNextAppointment', undefined, locale),
            versionLabel: t('assessment.version', undefined, locale),
          }}
        />
      </section>

      {/* ## 3. Testimonial — `account/testimonial` inlined. The panel
          renders its own `<h2>` ("Your testimonial"), so it is already this
          section's heading and needs no wrapper. */}
      <TestimonialPanel
        client:only="react"
        locale={locale}
        strings={{
          heading: t('accountTestimonial.panelHeading', undefined, locale),
          intro: t('accountTestimonial.intro', undefined, locale),
          loading: t('accountTestimonial.loading', undefined, locale),
          forbidden: t('accountTestimonial.forbidden', undefined, locale),
          unavailable: t('accountTestimonial.unavailable', undefined, locale),
          error: t('accountTestimonial.error', undefined, locale),
          quoteLabel: t('testimonials.form.quoteLabel', undefined, locale),
          displayLabel: t('testimonials.form.attributionDisplayLabel', undefined, locale),
          displayFull: t('testimonials.form.attributionDisplay.full', undefined, locale),
          displayFirstNameOnly: t(
            'testimonials.form.attributionDisplay.firstNameOnly',
            undefined,
            locale,
          ),
          displayAnonymous: t('testimonials.form.attributionDisplay.anonymous', undefined, locale),
          nameLabel: t('testimonials.form.attributionNameLabel', undefined, locale),
          nameRequired: t('accountTestimonial.nameRequired', undefined, locale),
          consentNotice: t('accountTestimonial.consentNotice', undefined, locale),
          publishButton: t('accountTestimonial.publish', undefined, locale),
          updateButton: t('accountTestimonial.update', undefined, locale),
          saving: t('accountTestimonial.saving', undefined, locale),
          savedMessage: t('accountTestimonial.saved', undefined, locale),
          withdrawButton: t('accountTestimonial.withdraw', undefined, locale),
          withdrawnMessage: t('accountTestimonial.withdrawn', undefined, locale),
          withdrawnNotice: t('accountTestimonial.withdrawnNotice', undefined, locale),
          saveFailed: t('accountTestimonial.saveFailed', undefined, locale),
        }}
      />

      {/* ## 4. Account — the password form from `account/change-password`.
          Only the password form: that page also carries `OwnDetailsPanel`,
          which the API serves to *staff* (`GET /clinicians/me`) and refuses
          a patient, so inlining it here would render a permanent
          "you do not have access" panel on a patient's own dashboard. */}
      <section aria-labelledby="account-section-heading">
        <Heading level={2} id="account-section-heading">
          {t('account.accountSectionHeading', undefined, locale)}
        </Heading>
        <ChangePasswordPanel
          client:only="react"
          headingLevel={PANEL_HEADING_LEVEL}
          strings={{
            heading: t('changePassword.heading', undefined, locale),
            intro: t('changePassword.intro', undefined, locale),
            currentPasswordLabel: t('changePassword.currentPasswordLabel', undefined, locale),
            newPasswordLabel: t('changePassword.newPasswordLabel', undefined, locale),
            confirmPasswordLabel: t('changePassword.confirmPasswordLabel', undefined, locale),
            submitButton: t('changePassword.submitButton', undefined, locale),
            submitting: t('changePassword.submitting', undefined, locale),
            successMessage: t('changePassword.successMessage', undefined, locale),
            mismatchError: t('changePassword.mismatchError', undefined, locale),
            forbidden: t('changePassword.forbidden', undefined, locale),
            incorrectCurrentPasswordError: t(
              'changePassword.incorrectCurrentPasswordError',
              undefined,
              locale,
            ),
            policyViolationError: t('changePassword.policyViolationError', undefined, locale),
            error: t('changePassword.error', undefined, locale),
          }}
        />
      </section>
    </RequireAuth>

    {/* ## Account — the staff half of the same section the patient gets.
        *"have an account section to reset password just like you did for
        patient."*

        It carries **both** panels from `account/change-password`, not just
        the password form: `OwnDetailsPanel` is served by `GET /clinicians/me`
        and is where a clinician sets their own display name. Inlining only
        the password form would have left that reachable by typed URL alone,
        which is the exact problem this dashboard has spent three changes
        undoing. The link is gone because the page's whole content is here.

        Patients are excluded: `GET /clinicians/me` refuses them, so they
        would get a permanent "you do not have access" panel — and they have
        their own Account section above. */}
    <RequireAuth
      client:only="react"
      allowRoles={['principal-clinician', 'sub-clinician', 'helpdesk', 'visitor']}
    >
      <section aria-labelledby="staff-account-heading">
        <Heading level={2} id="staff-account-heading">
          {t('account.accountSectionHeading', undefined, locale)}
        </Heading>
        <OwnDetailsPanel
          client:only="react"
          headingLevel={PANEL_HEADING_LEVEL}
          strings={{
            heading: t('ownDetails.heading', undefined, locale),
            intro: t('ownDetails.intro', undefined, locale),
            displayNameLabel: t('ownDetails.displayNameLabel', undefined, locale),
            saveButton: t('ownDetails.saveButton', undefined, locale),
            saving: t('ownDetails.saving', undefined, locale),
            savedMessage: t('ownDetails.savedMessage', undefined, locale),
            loading: t('ownDetails.loading', undefined, locale),
            forbidden: t('ownDetails.forbidden', undefined, locale),
            error: t('ownDetails.error', undefined, locale),
          }}
        />
        <ChangePasswordPanel
          client:only="react"
          headingLevel={PANEL_HEADING_LEVEL}
          strings={{
            heading: t('changePassword.heading', undefined, locale),
            intro: t('changePassword.intro', undefined, locale),
            currentPasswordLabel: t('changePassword.currentPasswordLabel', undefined, locale),
            newPasswordLabel: t('changePassword.newPasswordLabel', undefined, locale),
            confirmPasswordLabel: t('changePassword.confirmPasswordLabel', undefined, locale),
            submitButton: t('changePassword.submitButton', undefined, locale),
            submitting: t('changePassword.submitting', undefined, locale),
            successMessage: t('changePassword.successMessage', undefined, locale),
            mismatchError: t('changePassword.mismatchError', undefined, locale),
            forbidden: t('changePassword.forbidden', undefined, locale),
            incorrectCurrentPasswordError: t(
              'changePassword.incorrectCurrentPasswordError',
              undefined,
              locale,
            ),
            policyViolationError: t('changePassword.policyViolationError', undefined, locale),
            error: t('changePassword.error', undefined, locale),
          }}
        />
      </section>
    </RequireAuth>
    <RequireAuth
      client:only="react"
      allowRoles={['principal-clinician', 'sub-clinician', 'helpdesk', 'visitor']}
    >
      <nav aria-label={t('account.staffToolsHeading', undefined, locale)}>
        <ul>
          <li>
            <Link href={`/${locale}/account/caseload`}>
              {t('account.dashboardLink', undefined, locale)}
            </Link>
          </li>
        </ul>
      </nav>
    </RequireAuth>
    <RequireAuth client:only="react" allowRoles={['principal-clinician', 'helpdesk']}>
      <nav aria-label={t('account.patientAdminLink', undefined, locale)}>
        <ul>
          <li>
            <Link href={`/${locale}/account/patient-admin`}>
              {t('account.patientAdminLink', undefined, locale)}
            </Link>
          </li>
        </ul>
      </nav>
    </RequireAuth>
    <RequireAuth client:only="react" allowRoles={['principal-clinician']}>
      <nav aria-label={t('account.principalToolsHeading', undefined, locale)}>
        <ul>
          <li>
            <Link href={`/${locale}/account/clinician-admin`}>
              {t('account.clinicianAdminLink', undefined, locale)}
            </Link>
          </li>
          <li>
            <Link href={`/${locale}/account/authoring`}>
              {t('account.authoringLink', undefined, locale)}
            </Link>
          </li>
        </ul>
      </nav>
    </RequireAuth>
  </RequireAuth>
</BaseLayout>

{/* One `set:html` block for the calendar island's styles. An island cannot
    ship its own inline `<style>` and rely on it surviving this site's CSP,
    and the string lives in its own module so it is not also bundled into the
    client JavaScript — see `account/calendar-styles.ts`. */}
<style set:html={appointmentCalendarStylesCss} />
