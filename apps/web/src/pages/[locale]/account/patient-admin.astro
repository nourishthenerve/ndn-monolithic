---
// D-29 (2026-08-29): the staff-facing page for creating a patient account
// and resetting a patient's password. Statically generated and **empty**,
// same discipline account/caseload.astro states — what makes this page
// private is not server rendering but that its content is not in the
// HTML at all. The island below decides whether to render any forms, and
// renders nothing until the session resolves.
//
// Deliberately absent from routes.ts, same as account/caseload.astro and
// account/messages.astro — TASK 1.1.3's a11y gate (tests/pr-env/
// a11y-full.test.ts) scans every registered route unauthenticated, and an
// authenticated-only page has no accessible content to find that way.
// This codebase has no live-session pr-env testing mechanism yet for
// this page either — the same honestly-named gap every account-shell
// page added since TASK 5.3.1 names.
import { supportedLocales, t } from '@ndn/i18n';
import type { Locale } from '@ndn/i18n';
import { Heading } from '@ndn/ui';

import { PatientAdminPanel } from '../../../account/PatientAdminPanel.js';
import { RequireAuth } from '../../../auth/RequireAuth.js';
import { SignInLink, SignOutButton } from '../../../auth/SignInPanel.js';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { siteName } from '../../../site-config.js';

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const heading = t('patientAdmin.heading', undefined, locale);
---

<BaseLayout
  locale={locale}
  title={`${heading} — ${siteName}`}
  description={t('patientAdmin.description', undefined, locale)}
>
  <Heading level={1}>{heading}</Heading>

  <RequireAuth
    client:only="react"
    loadingLabel={t('account.loading', undefined, locale)}
    allowRoles={['principal-clinician', 'helpdesk']}
  >
    <Fragment slot="signedOut">
      <p>
        {t('account.signedOut', undefined, locale)}{' '}
        <SignInLink label={t('account.signInClinician', undefined, locale)} pool="clinician" />
      </p>
    </Fragment>
    <Fragment slot="forbidden">
      <p>{t('patientAdmin.forbidden', undefined, locale)}</p>
    </Fragment>
    <PatientAdminPanel
      client:only="react"
      strings={{
        forbidden: t('patientAdmin.forbidden', undefined, locale),
        createHeading: t('patientAdmin.createHeading', undefined, locale),
        createIntro: t('patientAdmin.createIntro', undefined, locale),
        emailLabel: t('patientAdmin.emailLabel', undefined, locale),
        fullNameLabel: t('patientAdmin.fullNameLabel', undefined, locale),
        phoneLabel: t('patientAdmin.phoneLabel', undefined, locale),
        marketingOptInLabel: t('patientAdmin.marketingOptInLabel', undefined, locale),
        referralSourceLabel: t('patientAdmin.referralSourceLabel', undefined, locale),
        presentingConditionLabel: t('patientAdmin.presentingConditionLabel', undefined, locale),
        createButton: t('patientAdmin.createButton', undefined, locale),
        creating: t('patientAdmin.creating', undefined, locale),
        createSuccessHeading: t('patientAdmin.createSuccessHeading', undefined, locale),
        createSuccessWarning: t('patientAdmin.createSuccessWarning', undefined, locale),
        passwordLabel: t('patientAdmin.passwordLabel', undefined, locale),
        patientIdLabel: t('patientAdmin.patientIdLabel', undefined, locale),
        createConflictError: t('patientAdmin.createConflictError', undefined, locale),
        createValidationError: t('patientAdmin.createValidationError', undefined, locale),
        createError: t('patientAdmin.createError', undefined, locale),
        assignClinicianLabel: t('patientAdmin.assignClinicianLabel', undefined, locale),
        assignClinicianNone: t('patientAdmin.assignClinicianNone', undefined, locale),
        assignClinicianHint: t('patientAdmin.assignClinicianHint', undefined, locale),
        assignedToLabel: t('patientAdmin.assignedToLabel', undefined, locale),
        assignFailedWarning: t('patientAdmin.assignFailedWarning', undefined, locale),
        findHeading: t('patientAdmin.findHeading', undefined, locale),
        findIntro: t('patientAdmin.findIntro', undefined, locale),
        findButton: t('patientAdmin.findButton', undefined, locale),
        finding: t('patientAdmin.finding', undefined, locale),
        findNotFoundError: t('patientAdmin.findNotFoundError', undefined, locale),
        findError: t('patientAdmin.findError', undefined, locale),
        foundPatientLabel: t('patientAdmin.foundPatientLabel', undefined, locale),
        foundStatusLabel: t('patientAdmin.foundStatusLabel', undefined, locale),
        useIdButton: t('patientAdmin.useIdButton', undefined, locale),
        resetHeading: t('patientAdmin.resetHeading', undefined, locale),
        resetIntro: t('patientAdmin.resetIntro', undefined, locale),
        patientIdInputLabel: t('patientAdmin.patientIdInputLabel', undefined, locale),
        resetButton: t('patientAdmin.resetButton', undefined, locale),
        resetting: t('patientAdmin.resetting', undefined, locale),
        resetSuccessHeading: t('patientAdmin.resetSuccessHeading', undefined, locale),
        resetSuccessWarning: t('patientAdmin.resetSuccessWarning', undefined, locale),
        resetNotFoundError: t('patientAdmin.resetNotFoundError', undefined, locale),
        resetError: t('patientAdmin.resetError', undefined, locale),
      }}
    />
    <SignOutButton client:only="react" label={t('account.signOut', undefined, locale)} />
  </RequireAuth>
</BaseLayout>
