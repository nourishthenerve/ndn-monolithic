---
// 2026-08-31: staff looking at one named patient — the screen the owner's
// *"the helpdesk should be able to view patient dashboard and patient
// details"* found missing. `/account/patient` reads `/patients/me` and
// belongs to the patient themselves; the dashboard listed patients and
// linked to nothing. This is the missing middle, reached with
// `?id=<patientId>` from the dashboard.
//
// Statically generated and **empty**, same discipline every account page
// states — what makes it private is that no patient content is in the
// HTML at all. The `?id=` is read client-side by the island, which is
// also why this page needs no server rendering to be per-patient.
//
// Deliberately absent from routes.ts, same as every sibling account page
// — TASK 1.1.3's a11y gate scans registered routes unauthenticated.
//
// ## 2026-09-07 — the four named areas of a patient record
//
// The owner: *"I want the following sections for a patient - 'Patient
// Details', 'Patient Assessment Form', 'Patient Prescription', and
// 'Patient Appointments'."* This page is where all four exist at once,
// because it is the only screen that shows a *named* patient to staff.
//
// **The page names the areas; the server decides which of them has
// anything in it.** Each `AssessmentForm` below is one placement, filtered
// to a single `fieldSet`, and it renders `null` when the server did not
// send that section — so a helpdesk account, denied `private{}`, gets no
// empty "Patient Assessment Form" heading with nothing under it. The
// heading is inside the same `RequireAuth` gate for that reason: a page
// that prints a heading for something you cannot see is telling you it
// exists, which is the one thing the assessment sections are careful not
// to do.
//
// **Visitors are admitted now, and that is a fix rather than a widening.**
// This page's `allowRoles` refused them while `authz-matrix.ts` has
// granted a visitor `R` on `general{}` and `calendar{}` (IIC-tagged) since
// 2026-09-01 and the dashboard's caseload table has linked visitors
// straight here for just as long — so a visitor who clicked a patient got
// "you do not have access" for a record the matrix says they may read. The
// server was always the decision; this page was refusing ahead of it, and
// wrongly. Two of the four areas resolve to nothing for them, by the same
// mechanism as helpdesk above.
import { supportedLocales, t } from '@ndn/i18n';
import type { Locale } from '@ndn/i18n';
import { Heading } from '@ndn/ui';

import { AppointmentBooking } from '../../../account/AppointmentBooking.js';
import { AssessmentForm } from '../../../account/AssessmentForm.js';
import { PatientRecordPanel } from '../../../account/PatientRecordPanel.js';
import { RequireAuth } from '../../../auth/RequireAuth.js';
import { SignInLink } from '../../../auth/SignInPanel.js';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { siteName } from '../../../site-config.js';

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const heading = t('patientRecord.heading', undefined, locale);

/**
 * Every panel gathered under one of the four area headings renders its own
 * heading one level down, so the outline reads "page > area > panel". Same
 * convention as the dashboard — see `account/heading-level.ts`.
 */
const PANEL_HEADING_LEVEL = 3;

/**
 * One object, four placements. The form's copy does not vary by which
 * section a placement shows — the section's *title* is the only part that
 * did, and the page supplies that now — so building it once is what keeps
 * the four mounts below from drifting apart.
 */
const assessmentStrings = {
  heading: t('assessment.heading', undefined, locale),
  loadingLabel: t('assessment.loading', undefined, locale),
  forbiddenLabel: t('assessment.forbidden', undefined, locale),
  notFoundLabel: t('assessment.notFound', undefined, locale),
  errorLabel: t('assessment.error', undefined, locale),
  missingIdLabel: t('assessment.missingId', undefined, locale),
  saveLabel: t('assessment.save', undefined, locale),
  savingLabel: t('assessment.saving', undefined, locale),
  savedLabel: t('assessment.saved', undefined, locale),
  autosavedLabel: t('assessment.autosaved', undefined, locale),
  conflictLabel: t('assessment.conflict', undefined, locale),
  saveForbiddenLabel: t('assessment.saveForbidden', undefined, locale),
  readOnlyLabel: t('assessment.readOnly', undefined, locale),
  attachmentsHeading: t('assessment.attachmentsHeading', undefined, locale),
  attachmentsEmpty: t('assessment.attachmentsEmpty', undefined, locale),
  addFileLabel: t('assessment.addFile', undefined, locale),
  uploadingLabel: t('assessment.uploading', undefined, locale),
  uploadFailedLabel: t('assessment.uploadFailed', undefined, locale),
  downloadLabel: t('assessment.download', undefined, locale),
  addRowLabel: t('assessment.addRow', undefined, locale),
  removeRowLabel: t('assessment.removeRow', undefined, locale),
  addRowAriaTemplate: t('assessment.addRowAria', { field: '{field}' }, locale),
  removeRowAriaTemplate: t('assessment.removeRowAria', { row: '{row}', field: '{field}' }, locale),
  cellLabelTemplate: t('assessment.cellLabel', { field: '{field}', column: '{column}', row: '{row}' }, locale),
  noNextAppointmentLabel: t('assessment.noNextAppointment', undefined, locale),
  versionLabel: t('assessment.version', undefined, locale),
};
---

<BaseLayout
  locale={locale}
  title={`${heading} — ${siteName}`}
  description={t('patientRecord.description', undefined, locale)}
>
  <Heading level={1}>{heading}</Heading>

  <RequireAuth
    client:only="react"
    loadingLabel={t('account.loading', undefined, locale)}
    allowRoles={['principal-clinician', 'sub-clinician', 'helpdesk', 'visitor']}
  >
    <Fragment slot="signedOut">
      <p>
        {t('account.signedOut', undefined, locale)}{' '}
        <SignInLink label={t('account.signInClinician', undefined, locale)} pool="clinician" />
      </p>
    </Fragment>
    <Fragment slot="forbidden">
      <p>{t('patientRecord.forbidden', undefined, locale)}</p>
    </Fragment>

    {/* ## 1. Patient Details — who this person is, then the record's own
        `general{}` section. Two islands under one heading: the identity
        fields are the Cognito-backed patient profile (`/patients/{id}`),
        the rest is the assessment record. They are two stores and two
        permissions, and the owner's area name covers both.

        2026-09-06: `dashboardHref` was `account/caseload`, which is
        deleted — its table is a section of the dashboard now, so "back to
        dashboard" points at the dashboard, where the table it means
        actually is. It renders once, with this half. */}
    <section aria-labelledby="patient-details-heading">
      <Heading level={2} id="patient-details-heading">
        {t('account.section.patientDetails', undefined, locale)}
      </Heading>
      <PatientRecordPanel
        client:only="react"
        half="details"
        locale={locale}
        dashboardHref={`/${locale}/account`}
        strings={{
          loadingLabel: t('patientRecord.loading', undefined, locale),
          forbiddenLabel: t('patientRecord.forbidden', undefined, locale),
          notFoundLabel: t('patientRecord.notFound', undefined, locale),
          errorLabel: t('patientRecord.error', undefined, locale),
          missingIdLabel: t('patientRecord.missingId', undefined, locale),
          detailsHeading: t('patientRecord.detailsHeading', undefined, locale),
          fullNameLabel: t('patientAdmin.fullNameLabel', undefined, locale),
          emailLabel: t('patientAdmin.emailLabel', undefined, locale),
          phoneLabel: t('patientAdmin.phoneLabel', undefined, locale),
          marketingOptInLabel: t('patientAdmin.marketingOptInLabel', undefined, locale),
          statusLabel: t('caseload.statusColumn', undefined, locale),
          assignedClinicianLabel: t('caseload.clinicianColumn', undefined, locale),
          unassignedLabel: t('caseload.unassigned', undefined, locale),
          saveButton: t('patientRecord.saveButton', undefined, locale),
          saving: t('patientRecord.saving', undefined, locale),
          savedMessage: t('patientRecord.savedMessage', undefined, locale),
          statusPendingLabel: t('caseload.statusPending', undefined, locale),
          statusApprovedLabel: t('caseload.statusApproved', undefined, locale),
          statusDeclinedLabel: t('caseload.statusDeclined', undefined, locale),
          statusSuspendedLabel: t('caseload.statusSuspended', undefined, locale),
          appointmentsHeading: t('patientRecord.appointmentsHeading', undefined, locale),
          appointmentsEmpty: t('patientRecord.appointmentsEmpty', undefined, locale),
          appointmentsError: t('patientRecord.appointmentsError', undefined, locale),
          whenColumnLabel: t('patientRecord.whenColumn', undefined, locale),
          durationColumnLabel: t('patientRecord.durationColumn', undefined, locale),
          appointmentStatusColumnLabel: t(
            'patientRecord.appointmentStatusColumn',
            undefined,
            locale,
          ),
          minutesSuffix: t('patientRecord.minutesSuffix', undefined, locale),
          decisionColumnLabel: t('patientRecord.decisionColumn', undefined, locale),
          approveButton: t('clinicianCalendar.approve', undefined, locale),
          declineButton: t('clinicianCalendar.decline', undefined, locale),
          decideFailedLabel: t('clinicianCalendar.decideFailed', undefined, locale),
          /* The same key `/account/calendar` uses — one label for one
             action, so the two clinician-facing appointment tables cannot
             drift into calling it different things. */
          joinCallLabel: t('calendar.joinCall', undefined, locale),
          backToDashboard: t('patientRecord.backToDashboard', undefined, locale),
        }}
      />
      <AssessmentForm
        client:only="react"
        fieldSets={['general']}
        showTitles={false}
        headingLevel={PANEL_HEADING_LEVEL}
        strings={assessmentStrings}
      />
    </section>

    {/* ## 2. Patient Assessment Form — the clinician-only section.
        *"Patient Assessment will only be visible to clinician and
        principal clinician."* That is `private{}`'s matrix row exactly, and
        it is the server that enforces it: this placement renders nothing
        at all for a helpdesk or visitor session, so the heading is gated
        alongside it rather than left standing over an empty area. */}
    <RequireAuth client:only="react" allowRoles={['principal-clinician', 'sub-clinician']}>
      <section aria-labelledby="patient-assessment-heading">
        <Heading level={2} id="patient-assessment-heading">
          {t('account.section.patientAssessment', undefined, locale)}
        </Heading>
        <AssessmentForm
          client:only="react"
          fieldSets={['private']}
          showTitles={false}
          showVersion={false}
          headingLevel={PANEL_HEADING_LEVEL}
          strings={assessmentStrings}
        />
      </section>
    </RequireAuth>

    {/* ## 3. Patient Prescription — *"visible to only patient, clinician,
        principal clinician and help desk"*, which is `prescription{}`'s row
        (a visitor is denied it). Gated for the visitor for the same reason
        as the section above: no heading over an area they cannot see
        into. */}
    <RequireAuth
      client:only="react"
      allowRoles={['principal-clinician', 'sub-clinician', 'helpdesk']}
    >
      <section aria-labelledby="patient-prescription-heading">
        <Heading level={2} id="patient-prescription-heading">
          {t('account.section.patientPrescription', undefined, locale)}
        </Heading>
        <AssessmentForm
          client:only="react"
          fieldSets={['prescription']}
          showTitles={false}
          showVersion={false}
          headingLevel={PANEL_HEADING_LEVEL}
          strings={assessmentStrings}
        />
      </section>
    </RequireAuth>

    {/* ## 4. Patient Appointments — the table, the booking form, and the
        record's own `calendar{}` figures, which are derived from the same
        `APPT#` rows the table lists.

        Booking lives here rather than on the clinician's own calendar for
        the reason `AppointmentBooking.tsx` gives: a booking is *about a
        patient*, and this is the page where one has been chosen. It reads
        the same `?id=` every island above resolves. */}
    <section aria-labelledby="patient-appointments-heading">
      <Heading level={2} id="patient-appointments-heading">
        {t('account.section.patientAppointments', undefined, locale)}
      </Heading>
      <PatientRecordPanel
        client:only="react"
        half="appointments"
        locale={locale}
        dashboardHref={`/${locale}/account`}
        strings={{
          loadingLabel: t('patientRecord.loading', undefined, locale),
          forbiddenLabel: t('patientRecord.forbidden', undefined, locale),
          notFoundLabel: t('patientRecord.notFound', undefined, locale),
          errorLabel: t('patientRecord.error', undefined, locale),
          missingIdLabel: t('patientRecord.missingId', undefined, locale),
          detailsHeading: t('patientRecord.detailsHeading', undefined, locale),
          fullNameLabel: t('patientAdmin.fullNameLabel', undefined, locale),
          emailLabel: t('patientAdmin.emailLabel', undefined, locale),
          phoneLabel: t('patientAdmin.phoneLabel', undefined, locale),
          marketingOptInLabel: t('patientAdmin.marketingOptInLabel', undefined, locale),
          statusLabel: t('caseload.statusColumn', undefined, locale),
          assignedClinicianLabel: t('caseload.clinicianColumn', undefined, locale),
          unassignedLabel: t('caseload.unassigned', undefined, locale),
          saveButton: t('patientRecord.saveButton', undefined, locale),
          saving: t('patientRecord.saving', undefined, locale),
          savedMessage: t('patientRecord.savedMessage', undefined, locale),
          statusPendingLabel: t('caseload.statusPending', undefined, locale),
          statusApprovedLabel: t('caseload.statusApproved', undefined, locale),
          statusDeclinedLabel: t('caseload.statusDeclined', undefined, locale),
          statusSuspendedLabel: t('caseload.statusSuspended', undefined, locale),
          appointmentsHeading: t('patientRecord.appointmentsHeading', undefined, locale),
          appointmentsEmpty: t('patientRecord.appointmentsEmpty', undefined, locale),
          appointmentsError: t('patientRecord.appointmentsError', undefined, locale),
          whenColumnLabel: t('patientRecord.whenColumn', undefined, locale),
          durationColumnLabel: t('patientRecord.durationColumn', undefined, locale),
          appointmentStatusColumnLabel: t(
            'patientRecord.appointmentStatusColumn',
            undefined,
            locale,
          ),
          minutesSuffix: t('patientRecord.minutesSuffix', undefined, locale),
          decisionColumnLabel: t('patientRecord.decisionColumn', undefined, locale),
          approveButton: t('clinicianCalendar.approve', undefined, locale),
          declineButton: t('clinicianCalendar.decline', undefined, locale),
          decideFailedLabel: t('clinicianCalendar.decideFailed', undefined, locale),
          joinCallLabel: t('calendar.joinCall', undefined, locale),
          backToDashboard: t('patientRecord.backToDashboard', undefined, locale),
        }}
      />
      <RequireAuth
        client:only="react"
        allowRoles={['principal-clinician', 'sub-clinician', 'helpdesk']}
      >
        <AppointmentBooking
          client:only="react"
          strings={{
            heading: t('appointmentBooking.heading', undefined, locale),
            whenLabel: t('appointmentBooking.when', undefined, locale),
            durationLabel: t('appointmentBooking.duration', undefined, locale),
            submitLabel: t('appointmentBooking.submit', undefined, locale),
            busyLabel: t('appointmentBooking.busy', undefined, locale),
            successLabel: t('appointmentBooking.success', undefined, locale),
            pendingNoticeLabel: t('appointmentBooking.pendingNotice', undefined, locale),
            conflictLabel: t('appointmentBooking.conflict', undefined, locale),
            forbiddenLabel: t('appointmentBooking.forbidden', undefined, locale),
            failedLabel: t('appointmentBooking.failed', undefined, locale),
          }}
        />
      </RequireAuth>
      <AssessmentForm
        client:only="react"
        fieldSets={['calendar']}
        showTitles={false}
        showVersion={false}
        headingLevel={PANEL_HEADING_LEVEL}
        strings={assessmentStrings}
      />
    </section>
  </RequireAuth>
</BaseLayout>
