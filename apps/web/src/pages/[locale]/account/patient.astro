---
// TASK 3.1.1 step 5: the patient's own profile — the first page inside
// the account shell (TASK 2.2.4) with a real capability behind it.
// Statically generated and **empty**, same discipline account/index.astro
// and account/caseload.astro already state — what makes this page private
// is not server rendering but that its content is not in the HTML at all.
// The island below decides whether to fetch anything, and renders nothing
// until the session resolves.
//
// Deliberately absent from routes.ts, same as every other authenticated
// account page — TASK 1.1.3's a11y gate (tests/pr-env/a11y-full.test.ts)
// scans every registered route unauthenticated, and an authenticated-only
// page has no accessible content to find that way. See
// docs/runbooks/patient-record.md for what accessibility verification
// this page actually has instead, and the real gap it names honestly:
// this codebase has no live-session pr-env testing mechanism yet, for
// this page or for every authenticated page before it.
//
// A clinician who signs in and browses here sees the same "forbidden"
// state `PatientProfile.tsx`'s own header already treats as an ordinary,
// expected outcome (its `/patients/me` fetch resolves to nothing a
// clinician principal owns) — not an error, and not worth branching the
// page itself on role for, the same posture every other account page in
// this codebase already takes.
//
// TASK 3.2.2: two `ClinicalRecordTimeline` instances (`diagnosis`,
// `care-plan`) added below `PatientProfile` — one component, two
// `kind` values, the same "one shape, two key prefixes" choice the
// backend already makes. Each renders exactly what `GET
// /patients/me/{diagnosis,care-plan}` returns, already stripped of any
// `private{}` half for a patient caller (`projection.ts`) — this page
// never re-filters that response.
//
// TASK 3.4.1 step 6: `NextAppointmentPanel` added below `PatientProfile`,
// ahead of the clinical-record timelines — an unambiguous data source
// unlike TASK 3.3.2's assessment history (`GET /patients/me/appointments`
// needs no per-form id the frontend would otherwise have no way to know).
import { supportedLocales, t } from '@ndn/i18n';
import type { Locale } from '@ndn/i18n';
import { Heading } from '@ndn/ui';

import { AssessmentForm } from '../../../account/AssessmentForm.js';
import { ClinicalRecordTimeline } from '../../../account/ClinicalRecordTimeline.js';
import { NextAppointmentPanel } from '../../../account/NextAppointmentPanel.js';
import { PatientProfile } from '../../../account/PatientProfile.js';
import { RequireAuth } from '../../../auth/RequireAuth.js';
import { SignInLink } from '../../../auth/SignInPanel.js';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { siteName } from '../../../site-config.js';

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const heading = t('patientProfile.heading', undefined, locale);
---

<BaseLayout
  locale={locale}
  title={`${heading} — ${siteName}`}
  description={t('patientProfile.description', undefined, locale)}
>
  <Heading level={1}>{heading}</Heading>

  <RequireAuth
    client:only="react"
    loadingLabel={t('account.loading', undefined, locale)}
    allowRoles={['patient']}
  >
    <Fragment slot="signedOut">
      <p>
        {t('account.signedOut', undefined, locale)}{' '}
        <SignInLink label={t('account.signInPatient', undefined, locale)} pool="patient" />
      </p>
    </Fragment>
    <Fragment slot="forbidden">
      <p>{t('patientProfile.forbidden', undefined, locale)}</p>
    </Fragment>
    <PatientProfile
      client:only="react"
      strings={{
        loadingLabel: t('patientProfile.loading', undefined, locale),
        forbiddenLabel: t('patientProfile.forbidden', undefined, locale),
        errorLabel: t('patientProfile.error', undefined, locale),
        savedLabel: t('patientProfile.saved', undefined, locale),
        fullNameLabel: t('patientProfile.fullName', undefined, locale),
        emailLabel: t('patientProfile.email', undefined, locale),
        phoneLabel: t('patientProfile.phone', undefined, locale),
        marketingOptInLabel: t('patientProfile.marketingOptIn', undefined, locale),
        saveLabel: t('patientProfile.save', undefined, locale),
        savingLabel: t('patientProfile.saving', undefined, locale),
      }}
    />
    <NextAppointmentPanel
      client:only="react"
      locale={locale}
      strings={{
        heading: t('nextAppointment.heading', undefined, locale),
        loadingLabel: t('nextAppointment.loading', undefined, locale),
        forbiddenLabel: t('nextAppointment.forbidden', undefined, locale),
        errorLabel: t('nextAppointment.error', undefined, locale),
        emptyLabel: t('nextAppointment.empty', undefined, locale),
        durationLabel: t('nextAppointment.duration', undefined, locale),
        joinCallLabel: t('nextAppointment.joinCall', undefined, locale),
      }}
    />
    <ClinicalRecordTimeline
      client:only="react"
      kind="diagnosis"
      strings={{
        heading: t('clinicalRecordTimeline.diagnosisHeading', undefined, locale),
        loadingLabel: t('clinicalRecordTimeline.loading', undefined, locale),
        forbiddenLabel: t('clinicalRecordTimeline.forbidden', undefined, locale),
        errorLabel: t('clinicalRecordTimeline.error', undefined, locale),
        emptyLabel: t('clinicalRecordTimeline.diagnosisEmpty', undefined, locale),
        versionLabel: t('clinicalRecordTimeline.version', undefined, locale),
      }}
    />
    <ClinicalRecordTimeline
      client:only="react"
      kind="care-plan"
      strings={{
        heading: t('clinicalRecordTimeline.carePlanHeading', undefined, locale),
        loadingLabel: t('clinicalRecordTimeline.loading', undefined, locale),
        forbiddenLabel: t('clinicalRecordTimeline.forbidden', undefined, locale),
        errorLabel: t('clinicalRecordTimeline.error', undefined, locale),
        emptyLabel: t('clinicalRecordTimeline.carePlanEmpty', undefined, locale),
        versionLabel: t('clinicalRecordTimeline.version', undefined, locale),
      }}
    />
    {/* 2026-09-01: the assessment form, on the page you reach by clicking
        a patient — the owner's own placement: *"it should appear when we
        create/register a new patient or when we click a patient in patient
        dashboard."* It was briefly a top-level nav item, which was wrong:
        the form is *about a patient*, so it has no meaning without one,
        and offering it before you have chosen a patient made the first
        thing it said "choose a patient from the dashboard".

        Here it resolves to the signed-in patient's own form (`me`), so no
        `?id=` is involved at all. They see the sections the server sends
        them, which is general info (theirs to edit), the patient section
        and the calendar (both read-only) — and never the clinician's. */}
    <AssessmentForm
      client:only="react"
      strings={{
        heading: t('assessment.heading', undefined, locale),
        loadingLabel: t('assessment.loading', undefined, locale),
        forbiddenLabel: t('assessment.forbidden', undefined, locale),
        notFoundLabel: t('assessment.notFound', undefined, locale),
        errorLabel: t('assessment.error', undefined, locale),
        missingIdLabel: t('assessment.missingId', undefined, locale),
        saveLabel: t('assessment.save', undefined, locale),
        savingLabel: t('assessment.saving', undefined, locale),
        savedLabel: t('assessment.saved', undefined, locale),
        conflictLabel: t('assessment.conflict', undefined, locale),
        saveForbiddenLabel: t('assessment.saveForbidden', undefined, locale),
        readOnlyLabel: t('assessment.readOnly', undefined, locale),
        attachmentsHeading: t('assessment.attachmentsHeading', undefined, locale),
        attachmentsEmpty: t('assessment.attachmentsEmpty', undefined, locale),
        addFileLabel: t('assessment.addFile', undefined, locale),
        uploadingLabel: t('assessment.uploading', undefined, locale),
        uploadFailedLabel: t('assessment.uploadFailed', undefined, locale),
        downloadLabel: t('assessment.download', undefined, locale),
        noNextAppointmentLabel: t('assessment.noNextAppointment', undefined, locale),
        versionLabel: t('assessment.version', undefined, locale),
      }}
    />
  </RequireAuth>
</BaseLayout>
