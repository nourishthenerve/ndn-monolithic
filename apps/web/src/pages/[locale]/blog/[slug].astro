---
// TASK 1.3.2 steps 3-4: per-language title/description(reusing the
// excerpt)/canonical URL, plus hreflang for every populated locale. Built
// statically per published post (ADR-0017: no SSR) — getStaticPaths fetches
// once and fans out to one path per (locale, post) pair, only for locales
// that post is actually translated into.
//
// Publishing/unpublishing a post takes effect on the content API
// immediately; this pre-rendered HTML only reflects that on the *next*
// `astro build` + deploy (see docs/runbooks/content-authoring.md's "What
// was deliberately not built here"). An id that was never published, or
// was unpublished before the last build, simply has no static path here —
// apps/web/src/pages/404.astro is what a visitor sees instead of a raw
// CloudFront/S3 403.
import { formatDayMonthYear, supportedLocales, t } from '@ndn/i18n';
import type { Locale } from '@ndn/i18n';
import { Heading } from '@ndn/ui';

import type { BlogPost } from '../../../blog/content-client.js';
import { fetchPublishedBlogPosts } from '../../../blog/content-client.js';
import { readingMinutes } from '../../../blog/reading-time.js';
import { buildHreflangLinks } from '../../../blog/seo.js';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { publicationDateOf } from '../../../publication-date.js';
import { renderableRichText, toPlainParagraphs } from '../../../rich-text/render.js';
import { proseStylesCss } from '../../../rich-text/styles.js';
import { mediaUrl, siteName, siteUrl } from '../../../site-config.js';

export async function getStaticPaths() {
  const posts = await fetchPublishedBlogPosts();
  return posts.flatMap((post) => {
    const populatedLocales = supportedLocales.filter((locale) => post.translations[locale]);
    return populatedLocales.map((locale) => ({
      params: { locale, slug: post.id },
      props: { post, populatedLocales },
    }));
  });
}

const { locale, slug } = Astro.params as { locale: Locale; slug: string };
const { post, populatedLocales } = Astro.props as { post: BlogPost; populatedLocales: Locale[] };

const translation = post.translations[locale];
if (!translation) {
  // Unreachable given getStaticPaths above only ever generates a path for
  // a locale the post has a translation for — a loud failure here would
  // mean that invariant broke, not a normal "content not ready" state.
  throw new Error(`blog/[slug].astro: no "${locale}" translation on post "${slug}"`);
}

const urlForLocale = (l: string) => `${siteUrl}/${l}/blog/${slug}`;
const canonicalHref = urlForLocale(locale);
const hreflangLinks = buildHreflangLinks(populatedLocales, urlForLocale);
// 2026-09-06: a post written in the rich-text editor is markup, and one
// written before it existed is plain text. `renderableRichText` answers which
// this is — and answers "plain text" for anything it cannot vouch for, so an
// unexpected body degrades to the reading this page has always given it
// rather than being injected on trust. See `rich-text/render.ts`.
const bodyHtml = renderableRichText(translation.body);
const bodyParagraphs = bodyHtml ? [] : toPlainParagraphs(translation.body);
const leadImage = post.imageKey ? mediaUrl(post.imageKey) : undefined;
// 2026-09-07: the byline date. `publishedAt` where the record has one,
// `created_at` for posts written before that field existed — see
// `apps/web/src/publication-date.ts`.
const publishedIso = publicationDateOf(post);
// Counted from the body this page renders, so the estimate and the article
// cannot be out of step — see `blog/reading-time.ts`.
const minutes = readingMinutes(translation.body);
---

<BaseLayout
  locale={locale}
  title={`${translation.title} — ${siteName}`}
  description={translation.excerpt}
  canonicalHref={canonicalHref}
  hreflangLinks={hreflangLinks}
>
  <article>
    <Heading level={1}>{translation.title}</Heading>
    {
      /* Directly under the headline, where a byline goes, and a real
         `<time>` so the date is machine-readable as well as legible. The
         reading estimate shares the line, exactly as it does on the card. */
      (publishedIso || minutes !== undefined) && (
        <p class="ndn-card-meta">
          {publishedIso && (
            <time datetime={publishedIso}>
              {t('common.publishedOn', { date: formatDayMonthYear(publishedIso, locale) }, locale)}
            </time>
          )}
          {publishedIso && minutes !== undefined ? ' · ' : ''}
          {minutes !== undefined && t('blog.readingTime', { minutes }, locale)}
        </p>
      )
    }
    {
      /* 2026-09-02: the lead image, at build time. `mediaUrl` answers
         undefined for a key outside the public `media/` prefix, so a post
         naming something private renders no image rather than a link to
         it — the same refusal the live component makes. */
      leadImage && <img src={leadImage} alt={t('blog.post.imageAlt', undefined, locale)} />
    }
    {
      bodyHtml ? (
        <div class="ndn-prose" set:html={bodyHtml} />
      ) : (
        bodyParagraphs.map((paragraph) => <p>{paragraph}</p>)
      )
    }
  </article>
</BaseLayout>

{/* Only the published look, never the editor's — this page is read signed
    out and has no toolbar on it. See `rich-text/styles.ts` for why the two
    stylesheets are separate. */}
<style set:html={proseStylesCss} />
