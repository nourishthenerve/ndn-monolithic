---
// TASK 1.1.2 hand-authored this page's own <html>/<head>/skip-link
// boilerplate before BaseLayout existed; TASK 1.2.1 introduces
// BaseLayout, and every page (including this one) now renders through it.
import { supportedLocales, t } from '@ndn/i18n';
import type { Locale } from '@ndn/i18n';
import { Button, Card, Heading, Input, Link as UiLink, VisuallyHidden } from '@ndn/ui';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteName } from '../../site-config.js';

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
---

<BaseLayout locale={locale} title={siteName} description={t('site.description', undefined, locale)}>
  <Heading level={1}>{siteName}</Heading>
  <p>{t('site.description', undefined, locale)}</p>

  <Card>
    <Heading level={2}>{t('common.getInTouch', undefined, locale)}</Heading>
    <Input
      label={t('home.emailLabel', undefined, locale)}
      type="email"
      name="email"
      autocomplete="email"
    />
    <Button type="submit">{t('common.send', undefined, locale)}</Button>
    <p><UiLink href={`/${locale}/about`}>{t('common.learnMoreAboutUs', undefined, locale)}</UiLink></p>
  </Card>

  <VisuallyHidden>{t('common.endOfPage', undefined, locale)}</VisuallyHidden>
</BaseLayout>
