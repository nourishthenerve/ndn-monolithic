---
// TASK 1.4.2: the public testimonials page — published testimonials,
// fetched at `astro build` time (ADR-0017: no SSR, same pattern
// apps/web/src/blog/index.astro established).
//
// **2026-09-02: read-only.** The owner: *"the testimonial page by default
// should be read only with all published testimonials by various patients
// … submit a testimonial shouldn't be available for public and all kinds
// of clinicians."*
//
// The submission form that used to sit below the quotes is gone, and with
// it the Turnstile widget, the contact-email field, and the consent notice
// a stranger had to be asked for. Writing a testimonial now happens in a
// patient's own account (`account/testimonial.astro`), where the author is
// already known and the consent is theirs to give and to take back.
import { supportedLocales, t } from '@ndn/i18n';
import type { Locale } from '@ndn/i18n';
import { Card, Heading } from '@ndn/ui';

import BaseLayout from '../../../layouts/BaseLayout.astro';
import { siteName } from '../../../site-config.js';
import { fetchPublishedTestimonials } from '../../../testimonials/testimonial-client.js';

export async function getStaticPaths() {
  const testimonials = await fetchPublishedTestimonials();
  return supportedLocales.map((locale) => ({ params: { locale }, props: { testimonials } }));
}

const { locale } = Astro.params as { locale: Locale };
const { testimonials } = Astro.props as {
  testimonials: Awaited<ReturnType<typeof fetchPublishedTestimonials>>;
};

const heading = t('testimonials.index.heading', undefined, locale);

function attributionLabel(testimonial: (typeof testimonials)[number]): string {
  if (testimonial.attribution.display === 'anonymous') {
    return t('testimonials.form.attributionDisplay.anonymous', undefined, locale);
  }
  return testimonial.attribution.name ?? '';
}
---

<BaseLayout
  locale={locale}
  title={`${heading} — ${siteName}`}
  description={t('testimonials.index.description', undefined, locale)}
>
  <Heading level={1}>{heading}</Heading>
  <p>{t('testimonials.index.intro', undefined, locale)}</p>

  {
    testimonials.length === 0 ? (
      <p>{t('testimonials.index.empty', undefined, locale)}</p>
    ) : (
      testimonials.map((testimonial) => (
        <Card>
          <blockquote>
            <p>{testimonial.quote[locale] ?? Object.values(testimonial.quote)[0]}</p>
            <footer>{attributionLabel(testimonial)}</footer>
          </blockquote>
        </Card>
      ))
    )
  }

</BaseLayout>
