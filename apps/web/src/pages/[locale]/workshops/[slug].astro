---
// TASK 1.5.1: the per-workshop detail page. Built statically per published,
// upcoming workshop (ADR-0017: no SSR) — getStaticPaths fetches once and
// fans out to one path per (locale, workshop) pair, only for locales that
// workshop is actually translated into. Mirrors
// apps/web/src/pages/[locale]/blog/[slug].astro's shape closely, including
// its hreflang handling.
//
// A workshop's poster/date/price are formatted here rather than passed as
// raw strings interpolated into JSX text, so packages/eslint-plugin-i18n's
// `ndn/no-hardcoded-strings` rule (apps/web-scoped) never sees a literal
// currency/punctuation string to flag — see that rule's own TemplateLiteral
// handling for why a computed Identifier expression avoids the question
// entirely.
import { formatDayMonthYear, supportedLocales, t } from '@ndn/i18n';
import type { Locale } from '@ndn/i18n';
import { Heading } from '@ndn/ui';

import { buildHreflangLinks } from '../../../blog/seo.js';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { publicationDateOf } from '../../../publication-date.js';
import {
  renderableRichText,
  richTextToPlainText,
  toPlainParagraphs,
} from '../../../rich-text/render.js';
import { proseStylesCss } from '../../../rich-text/styles.js';
import { siteName, siteUrl, workshopPosterUrl } from '../../../site-config.js';
import type { Workshop } from '../../../workshops/workshop-client.js';
import { fetchPublishedWorkshops } from '../../../workshops/workshop-client.js';

export async function getStaticPaths() {
  const workshops = await fetchPublishedWorkshops();
  return workshops.flatMap((workshop) => {
    const populatedLocales = supportedLocales.filter((locale) => workshop.details[locale]);
    return populatedLocales.map((locale) => ({
      params: { locale, slug: workshop.id },
      props: { workshop, populatedLocales },
    }));
  });
}

const { locale, slug } = Astro.params as { locale: Locale; slug: string };
const { workshop, populatedLocales } = Astro.props as {
  workshop: Workshop;
  populatedLocales: Locale[];
};

const detail = workshop.details[locale];
if (!detail) {
  // Unreachable given getStaticPaths above only ever generates a path for
  // a locale the workshop has a detail entry for — a loud failure here
  // would mean that invariant broke, not a normal "content not ready"
  // state (same posture blog/[slug].astro takes).
  throw new Error(`workshops/[slug].astro: no "${locale}" detail on workshop "${slug}"`);
}

const urlForLocale = (l: string) => `${siteUrl}/${l}/workshops/${slug}`;
const canonicalHref = urlForLocale(locale);
const hreflangLinks = buildHreflangLinks(populatedLocales, urlForLocale);

const formattedDate = new Intl.DateTimeFormat(locale, {
  dateStyle: 'long',
  timeStyle: 'short',
}).format(new Date(workshop.dateTimeUtc));
const posterSrc = workshop.posterKey ? workshopPosterUrl(workshop.posterKey) : undefined;
// 2026-09-07: when this was announced — not `dateTimeUtc`, and named
// separately below so the two dates cannot be read as one another. See
// `apps/web/src/publication-date.ts` for the `created_at` fallback that
// covers workshops announced before the field existed.
const announcedIso = publicationDateOf(workshop);
// 2026-09-06: the description is written in the rich-text editor now — see
// `blog/[slug].astro` for the same two-reading treatment of the same problem.
const descriptionHtml = renderableRichText(detail.description);
const descriptionParagraphs = descriptionHtml ? [] : toPlainParagraphs(detail.description);
// `<meta name="description">` takes a string, not markup: a page whose own
// description tag begins "<p>" ships those three characters to every search
// result that quotes it.
const metaDescription = richTextToPlainText(detail.description);
---

<BaseLayout
  locale={locale}
  title={`${detail.title} — ${siteName}`}
  description={metaDescription}
  canonicalHref={canonicalHref}
  hreflangLinks={hreflangLinks}
>
  <article>
    {
      /* Guarded on the URL, not the key — `workshopPosterUrl` answers
         undefined for anything outside the public `media/` prefix. */
      posterSrc && (
        <img
          src={posterSrc}
          alt={t('workshops.index.posterAlt', { title: detail.title }, locale)}
        />
      )
    }
    <Heading level={1}>{detail.title}</Heading>
    {
      descriptionHtml ? (
        <div class="ndn-prose" set:html={descriptionHtml} />
      ) : (
        descriptionParagraphs.map((paragraph) => <p>{paragraph}</p>)
      )
    }
    <dl>
      <dt>{t('workshops.detail.dateLabel', undefined, locale)}</dt>
      <dd>{formattedDate}</dd>
      {
        announcedIso && (
          <>
            <dt>{t('workshops.detail.announcedLabel', undefined, locale)}</dt>
            <dd>
              <time datetime={announcedIso}>{formatDayMonthYear(announcedIso, locale)}</time>
            </dd>
          </>
        )
      }
    </dl>
  </article>
</BaseLayout>

{/* Only the published look — see `blog/[slug].astro`. */}
<style set:html={proseStylesCss} />
