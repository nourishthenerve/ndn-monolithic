---
// TASK 1.5.1: the workshop listing page. Built statically at `astro build`
// time from a single fetch (ADR-0017: no SSR), same pattern
// apps/web/src/pages/[locale]/blog/index.astro established — an
// unreachable workshops API (e.g. the ephemeral PR environment, where
// NdnDataStack isn't deployed at all) just means zero workshops today, not
// a failed build.
import { supportedLocales, t } from '@ndn/i18n';
import type { Locale } from '@ndn/i18n';
import { Heading } from '@ndn/ui';

import BaseLayout from '../../../layouts/BaseLayout.astro';
import { siteName } from '../../../site-config.js';
import { LiveWorkshopList } from '../../../workshops/LiveWorkshopList.js';
import { fetchPublishedWorkshops } from '../../../workshops/workshop-client.js';

export async function getStaticPaths() {
  const workshops = await fetchPublishedWorkshops();
  return supportedLocales.map((locale) => ({ params: { locale }, props: { workshops } }));
}

const { locale } = Astro.params as { locale: Locale };
const { workshops } = Astro.props as {
  workshops: Awaited<ReturnType<typeof fetchPublishedWorkshops>>;
};

// A workshop not yet translated into this locale doesn't appear on this
// locale's listing — same rule apps/web/src/pages/[locale]/blog/index.astro
// applies to posts.
const workshopsForLocale = workshops
  .map((workshop) => ({ workshop, detail: workshop.details[locale] }))
  .filter(
    (entry): entry is { workshop: (typeof workshops)[number]; detail: NonNullable<typeof entry.detail> } =>
      entry.detail !== undefined,
  );

const heading = t('workshops.index.heading', undefined, locale);
---

<BaseLayout
  locale={locale}
  title={`${heading} — ${siteName}`}
  description={t('workshops.index.description', undefined, locale)}
>
  <Heading level={1}>{heading}</Heading>
  {/* 2026-09-02: an island seeded with the build-time list, so a workshop
      published since the last deploy appears without one. `client:load`
      keeps the seed in the HTML for crawlers and for no-JS readers — see
      blog/LiveBlogList.tsx's header. */}
  <LiveWorkshopList
    client:load
    locale={locale}
    initialWorkshops={workshopsForLocale.map(({ workshop }) => workshop)}
    strings={{
      empty: t('workshops.index.empty', undefined, locale),
      viewDetails: t('workshops.index.viewDetails', undefined, locale),
      posterAltTemplate: t('workshops.index.posterAlt', { title: '{title}' }, locale),
    }}
  />
</BaseLayout>
