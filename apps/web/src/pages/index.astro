---
// TASK 1.1.1: replaces the 0.4.1 "it's alive" placeholder with the first
// real page built from packages/ui's primitives — every component below
// renders with zero `client:*` directive, so this page ships zero JS
// (ADR-0017's "zero-JS-by-default" static-output story, proven for real).
import {
  Button,
  Card,
  colorSchemeCssVariables,
  Heading,
  Input,
  Link as UiLink,
  primitiveStylesCss,
  reducedMotionGlobalCss,
  SkipLink,
  typeTokenCssVariables,
  VisuallyHidden,
} from '@ndn/ui';

import { siteDescription, siteName } from '../site-config.js';

const rootVariables = { ...colorSchemeCssVariables('light'), ...typeTokenCssVariables() };
const rootCss = `:root {\n${Object.entries(rootVariables)
  .map(([name, value]) => `  ${name}: ${value};`)
  .join('\n')}\n}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{siteName}</title>
    <meta name="description" content={siteDescription} />
    <style set:html={rootCss} />
    <style set:html={reducedMotionGlobalCss} />
    <style set:html={primitiveStylesCss} />
  </head>
  <body>
    <SkipLink>Skip to main content</SkipLink>
    <main id="main">
      <Heading level={1}>{siteName}</Heading>
      <p>{siteDescription}</p>

      <Card>
        <Heading level={2}>Get in touch</Heading>
        <Input label="Email address" type="email" name="email" autocomplete="email" />
        <Button type="submit">Send</Button>
        <p><UiLink href="/about">Learn more about us</UiLink></p>
      </Card>

      <VisuallyHidden>You have reached the end of the page.</VisuallyHidden>
    </main>
  </body>
</html>
