{
  "name": "ndn-monolithic",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "lint": "pnpm -r run lint && node scripts/check-no-disable-comments.mjs",
    "lint:no-destructive": "eslint --no-ignore infra/src/__fixtures__/no-destructive",
    "typecheck": "pnpm -r run typecheck",
    "build:web": "pnpm --filter @ndn/web run build",
    "test": "pnpm run build:web && pnpm -r run test",
    "test:integration": "pnpm --filter @ndn/tests run test:integration",
    "test:pr-env": "pnpm --filter @ndn/tests run test:pr-env",
    "test:coverage": "pnpm run build:web && vitest run --coverage",
    "audit": "pnpm audit --audit-level=high",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@ndn/eslint-plugin-i18n": "workspace:*",
    "@ndn/eslint-plugin-no-destructive": "workspace:*",
    "@vitest/coverage-v8": "4.1.10",
    "astro-eslint-parser": "^3.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
