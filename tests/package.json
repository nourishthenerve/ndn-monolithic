{
  "name": "@ndn/tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:pr-env": "vitest run --config vitest.pr-env.config.ts && playwright test --config playwright.pr-env.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@ndn/i18n": "workspace:*",
    "@ndn/web": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "zod": "^4.4.3"
  }
}
